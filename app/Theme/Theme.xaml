<!-- Material 3 baseline dark colors. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:c="clr-namespace:LibreccioWeather.Controls"
                    xmlns:w="clr-namespace:LibreccioWeather.Windowing">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DarkColors.xaml" />
        <ResourceDictionary Source="WeatherCardArtwork.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <CornerRadius x:Key="ButtonCornerRadius">20</CornerRadius>
    <CornerRadius x:Key="ForecastCardCornerRadius">28</CornerRadius>
    <CornerRadius x:Key="SearchCornerRadius">28</CornerRadius>
    <CornerRadius x:Key="LocationCornerRadius">28</CornerRadius>
    <CornerRadius x:Key="ResultCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="FloatingActionCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="IconCornerRadius">20</CornerRadius>
    <Thickness x:Key="FilledButtonPadding">24,10</Thickness>
    <Thickness x:Key="TextButtonPadding">12,10</Thickness>

    <Thickness x:Key="LargeMargin">20</Thickness>

    <Thickness x:Key="NormalMargin">16</Thickness>
    <Thickness x:Key="SmallMargin">8</Thickness>

    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    <CornerRadius x:Key="DialogCornerRadius">28</CornerRadius>

    <Style x:Key="DialogSurface" TargetType="Border">
        <Setter Property="MaxWidth" Value="560" />
        <Setter Property="MinWidth" Value="280" />
        <Setter Property="Margin" Value="48" />
        <Setter Property="Padding" Value="24,24,16,8" />
        <Setter Property="CornerRadius" Value="{DynamicResource DialogCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}" />
    </Style>

    <!-- Text that takes no space while it has nothing to show. -->
    <Style x:Key="OptionalText" TargetType="TextBlock">
        <Style.Triggers>
            <Trigger Property="Text" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BodyMediumText" TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BodySmallText" TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
    </Style>

    <Style x:Key="TitleMediumText" TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
    </Style>

    <Style x:Key="TitleLargeText" TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
    </Style>

    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource SearchCornerRadius}">
                        <!-- Not rounded and not focusable; see OutlinedTextField. The text box gives its padding to the text
                             host itself. -->
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" UseLayoutRounding="False" Focusable="False" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NumberField" TargetType="TextBox">
        <Setter Property="Width" Value="80" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Outline" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <!-- Not rounded and not focusable; see OutlinedTextField. The text box gives its padding to the text
                             host itself. -->
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" UseLayoutRounding="False" Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource OnSurfaceBrush}" />
                        </Trigger>
                        <!-- A focused outlined field has a thicker primary outline; the padding shrinks to keep the text in place. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Outline" Property="BorderThickness" Value="2" />
                            <Setter Property="Padding" Value="11,7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Material 3 outlined text field, 56 high, with the colors the settings' text dialog sets: a 1-pixel on-surface-variant
         outline, 2 pixels in on-surface while focused, and the error color, caret included, while its content is invalid,
         which the Tag set to True marks. -->
    <Style x:Key="OutlinedTextField" TargetType="TextBox">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource OnSurfaceVariantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,15" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Outline" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <!-- Layout rounding, inherited from the window, moves the text to whole pixels while the caret is
                                 still placed from the unrounded glyph positions, so on a scaled display the caret lands inside
                                 a letter. The text host is therefore not rounded. The text box gives its padding to the text
                                 host itself; padding here as well would inset the text twice. A focusable scroll viewer takes
                                 focus on a left click and marks the click handled, so the text box never places the caret
                                 where the click landed; the host is therefore not focusable. -->
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" UseLayoutRounding="False" Focusable="False" />
                        </Border>
                        <!-- The thicker focused outline is a separate layer over the thin one, so focusing the field does not
                             re-arrange the text host after a click has placed the caret. -->
                        <Border x:Name="FocusOutline" BorderBrush="{DynamicResource OnSurfaceBrush}" BorderThickness="2"
                                CornerRadius="4" IsHitTestVisible="False" Visibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusOutline" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- Tag holds an object, so the value it is compared with is a Boolean rather than the text "True". -->
                        <Trigger Property="Tag">
                            <Trigger.Value>
                                <sys:Boolean>True</sys:Boolean>
                            </Trigger.Value>
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                            <Setter TargetName="FocusOutline" Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                            <Setter Property="CaretBrush" Value="{DynamicResource ErrorBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Material 3 slider, extra-small size: a 16-pixel track with 8-pixel outer corners and 2-pixel inner corners. -->
    <Style x:Key="SliderActiveTrack" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="16" CornerRadius="8,2,2,8" Background="{DynamicResource PrimaryBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderInactiveTrack" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="16" CornerRadius="2,8,8,2" Background="{DynamicResource SecondaryContainerBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppSlider" TargetType="c:MaterialSlider">
        <Setter Property="Height" Value="44" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:MaterialSlider">
                    <Grid>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderActiveTrack}" Command="{x:Static Slider.DecreaseLarge}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderInactiveTrack}" Command="{x:Static Slider.IncreaseLarge}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <!-- A 4-pixel handle with a 6-pixel gap on each side, which SliderStops relies on. -->
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Width="16" Height="44" Background="Transparent">
                                                <Border x:Name="Handle" Width="4" CornerRadius="2" Background="{DynamicResource PrimaryBrush}" />
                                                <!-- A canvas does not clip, so the value indicator can sit above the slider. -->
                                                <Canvas Width="16" Height="0" VerticalAlignment="Top">
                                                    <!-- 44 pixels high, 12 pixels above the handle. -->
                                                    <Border x:Name="Indicator" Canvas.Left="-16" Canvas.Top="-56" Width="48" Height="44"
                                                            CornerRadius="22" Background="{DynamicResource InverseSurfaceBrush}" Visibility="Collapsed">
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Medium"
                                                                   Foreground="{DynamicResource InverseOnSurfaceBrush}"
                                                                   Text="{Binding Value, RelativeSource={RelativeSource AncestorType=Slider}, StringFormat={}{0:0}}" />
                                                    </Border>
                                                </Canvas>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <!-- The handle narrows while pressed or focused. -->
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Handle" Property="Width" Value="2" />
                                                    <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <!-- The slider takes keyboard focus, not its handle, so the value shows from here. -->
                                                <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                                                    <Setter TargetName="Handle" Property="Width" Value="2" />
                                                    <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <c:SliderStops IsHitTestVisible="False" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value}" StopValue="{TemplateBinding StopValue}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HeadlineSmallText" TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TopAppBarTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- The hit target stays larger than the visible background. -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Layer" Width="40" Height="40" Background="Transparent"
                                CornerRadius="{DynamicResource IconCornerRadius}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Layer" Property="Background" Value="{DynamicResource HoverLayerBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FilledButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="{DynamicResource FilledButtonPadding}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Container" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ButtonCornerRadius}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Container" Property="Opacity" Value="0.92" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Container" Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource FilledButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="{DynamicResource TextButtonPadding}" />
    </Style>

    <!-- Material 3's outlined button: no fill, an outline and the primary color for its content. -->
    <Style x:Key="OutlinedButton" TargetType="Button" BasedOn="{StaticResource FilledButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- A floating action button, in the tertiary color. -->
    <Style x:Key="FloatingActionButton" TargetType="Button">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Background" Value="{DynamicResource TertiaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnTertiaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Container" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource FloatingActionCornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Container" Property="Opacity" Value="0.92" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A choice in a list dialog: a radio mark followed by its name. -->
    <Style x:Key="RadioOption" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Container" Background="Transparent" Padding="24,12">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="20" Height="20" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" Stroke="{DynamicResource OnSurfaceVariantBrush}" StrokeThickness="2" />
                                <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource PrimaryBrush}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Container" Property="Background" Value="{DynamicResource HoverLayerBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A Material 3 switch. -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="52" Height="32">
                        <Border x:Name="Track" CornerRadius="16" BorderThickness="2"
                                Background="{DynamicResource SurfaceContainerHighBrush}" BorderBrush="{DynamicResource OutlineBrush}" />
                        <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="8,0" HorizontalAlignment="Left"
                                 Fill="{DynamicResource OutlineBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource OnPrimaryBrush}" />
                            <Setter TargetName="Thumb" Property="Width" Value="24" />
                            <Setter TargetName="Thumb" Property="Height" Value="24" />
                            <Setter TargetName="Thumb" Property="Margin" Value="4,0" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ResultList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Container" Background="Transparent" CornerRadius="{DynamicResource ResultCornerRadius}" Padding="16,10">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Container" Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}" />
                                    </Trigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DataContext.IsDesktopInterfaceEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Container" Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}" />
                                    </MultiDataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CompactIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
    </Style>

    <!-- The window's own text in its title bar: Windows' caption type, 12 in Segoe UI Variable or Segoe UI. -->
    <Style x:Key="WindowTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Small, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Title bar content is half transparent while the window is inactive, as Windows asks of every title bar; the
         amount is Material 3's disabled content opacity. -->
    <Style x:Key="WindowTitleContent" TargetType="FrameworkElement">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                <Setter Property="Opacity" Value="0.38" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The window's minimize and maximize buttons, drawn as Windows draws its own: a Segoe Fluent Icons glyph, or the
         same glyph in Segoe MDL2 Assets before Windows 11, on a backplate as tall as the title bar. Hover and press add
         Material 3's state layers. Windows handles the pointer over the maximize button, so WindowCaption sets its
         states there. -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Backplate" Background="Transparent">
                        <TextBlock x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                            <Setter TargetName="Glyph" Property="Opacity" Value="0.38" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Backplate" Property="Background" Value="{DynamicResource HoverLayerBrush}" />
                        </Trigger>
                        <Trigger Property="w:WindowCaption.IsHovered" Value="True">
                            <Setter TargetName="Backplate" Property="Background" Value="{DynamicResource HoverLayerBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Backplate" Property="Background" Value="{DynamicResource PressedLayerBrush}" />
                        </Trigger>
                        <Trigger Property="w:WindowCaption.IsPressed" Value="True">
                            <Setter TargetName="Backplate" Property="Background" Value="{DynamicResource PressedLayerBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The window's close button, which turns Windows' red with a white glyph when hovered or pressed, even while the
         window is inactive. -->
    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Backplate" Background="Transparent">
                        <TextBlock x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                            <Setter TargetName="Glyph" Property="Opacity" Value="0.38" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Backplate" Property="Background" Value="{DynamicResource CaptionCloseBrush}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource OnCaptionCloseBrush}" />
                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Images keep their drawing in a right-to-left layout, as Android only mirrors a drawable marked to be mirrored. -->
    <Style TargetType="Image">
        <Setter Property="FlowDirection" Value="LeftToRight" />
    </Style>

    <!-- A tooltip opens outside the window it belongs to, so it takes the language's direction and digits from the
         resources. -->
    <Style TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
        <Setter Property="FlowDirection" Value="{DynamicResource AppFlowDirection}" />
        <Setter Property="NumberSubstitution.CultureSource" Value="{DynamicResource AppNumberCultureSource}" />
        <Setter Property="NumberSubstitution.CultureOverride" Value="{DynamicResource AppNumberCulture}" />
        <Setter Property="NumberSubstitution.Substitution" Value="{DynamicResource AppNumberSubstitution}" />
    </Style>

    <Style x:Key="AppContextMenu" TargetType="ContextMenu">
        <!-- A menu opens outside the window it belongs to, so it takes the language's direction and digits from the
             resources. -->
        <Setter Property="FlowDirection" Value="{DynamicResource AppFlowDirection}" />
        <Setter Property="NumberSubstitution.CultureSource" Value="{DynamicResource AppNumberCultureSource}" />
        <Setter Property="NumberSubstitution.CultureOverride" Value="{DynamicResource AppNumberCulture}" />
        <Setter Property="NumberSubstitution.Substitution" Value="{DynamicResource AppNumberSubstitution}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" Padding="4" CornerRadius="4"
                            BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <!-- Implicit styles here also reach the items of submenus, which follow the logical tree. -->
            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Grid>
                                <Border x:Name="Highlight" Padding="{TemplateBinding Padding}" CornerRadius="4" Background="Transparent">
                                    <DockPanel>
                                        <!-- The icons live in a sibling dictionary, so they are resolved at run time. -->
                                        <Path x:Name="Check" DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" FlowDirection="LeftToRight"
                                              Stretch="Uniform" Fill="{TemplateBinding Foreground}"
                                              Data="{DynamicResource IconCheck}" Visibility="Collapsed" />
                                        <Path x:Name="Arrow" DockPanel.Dock="Right" Width="16" Height="16" Margin="16,0,0,0"
                                              Stretch="Uniform" Fill="{TemplateBinding Foreground}"
                                              Data="{DynamicResource IconChevronRight}" Visibility="Collapsed" />
                                        <!-- Location names are shown as written, so an underscore is not an access key. -->
                                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                                <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="4" AllowsTransparency="True"
                                       Focusable="False" PopupAnimation="None"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="{DynamicResource SurfaceContainerHighBrush}" Padding="4" CornerRadius="4"
                                            BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Highlight" Property="Background" Value="{DynamicResource HoverLayerBrush}" />
                                </Trigger>
                                <Trigger Property="Role" Value="SubmenuHeader">
                                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <!-- Checkable items keep the check column so their names stay aligned. -->
                                <Trigger Property="IsCheckable" Value="True">
                                    <Setter TargetName="Check" Property="Visibility" Value="Hidden" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.38" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Height="1" Background="{DynamicResource OutlineBrush}" Opacity="0.5" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
    </Style>

    <!-- One scrollbar for the whole app: a thin rounded thumb with small arrows, and no track of its own. -->
    <Geometry x:Key="ScrollArrowUp">M0,5 L4,0 L8,5 Z</Geometry>
    <Geometry x:Key="ScrollArrowDown">M0,0 L8,0 L4,5 Z</Geometry>
    <Geometry x:Key="ScrollArrowLeft">M5,0 L0,4 L5,8 Z</Geometry>
    <Geometry x:Key="ScrollArrowRight">M0,0 L5,4 L0,8 Z</Geometry>

    <Style x:Key="ScrollBarArrow" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Path x:Name="Arrow" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{DynamicResource OnSurfaceVariantBrush}" Opacity="0.5"
                              Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Arrow" Property="Opacity" Value="0.87" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" Margin="3" CornerRadius="3" Background="{DynamicResource OnSurfaceVariantBrush}" Opacity="0.35" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="0.6" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                        </Grid.RowDefinitions>
                        <RepeatButton Style="{StaticResource ScrollBarArrow}" Command="ScrollBar.LineUpCommand"
                                      Tag="{StaticResource ScrollArrowUp}" />
                        <!-- Reversed so that the top of the track is the start of the content. -->
                        <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPage}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPage}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumb}" />
                            </Track.Thumb>
                        </Track>
                        <RepeatButton Grid.Row="2" Style="{StaticResource ScrollBarArrow}" Command="ScrollBar.LineDownCommand"
                                      Tag="{StaticResource ScrollArrowDown}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                </Grid.ColumnDefinitions>
                                <RepeatButton Style="{StaticResource ScrollBarArrow}" Command="ScrollBar.LineLeftCommand"
                                              Tag="{StaticResource ScrollArrowLeft}" />
                                <Track x:Name="PART_Track" Grid.Column="1">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarPage}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarPage}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumb}" />
                                    </Track.Thumb>
                                </Track>
                                <RepeatButton Grid.Column="2" Style="{StaticResource ScrollBarArrow}" Command="ScrollBar.LineRightCommand"
                                              Tag="{StaticResource ScrollArrowRight}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
