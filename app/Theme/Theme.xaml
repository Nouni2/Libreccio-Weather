<!-- Material 3 baseline dark colors. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:LibreccioWeather.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="WeatherCardArtwork.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <CornerRadius x:Key="ButtonCornerRadius">20</CornerRadius>
    <CornerRadius x:Key="ForecastCardCornerRadius">28</CornerRadius>
    <CornerRadius x:Key="SearchCornerRadius">28</CornerRadius>
    <CornerRadius x:Key="LocationCornerRadius">28</CornerRadius>
    <CornerRadius x:Key="ResultCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="FloatingActionCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="IconCornerRadius">20</CornerRadius>
    <Thickness x:Key="FilledButtonPadding">24,10</Thickness>
    <Thickness x:Key="TextButtonPadding">12,10</Thickness>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#141218" />
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="#211F26" />
    <SolidColorBrush x:Key="MainCardBackgroundBrush" Color="#1B1B1D" />
    <SolidColorBrush x:Key="MainCardArcRootBrush" Color="#1C1B1F" />
    <SolidColorBrush x:Key="MainCardTitleBrush" Color="#E3E2E6" />
    <SolidColorBrush x:Key="MainCardTextBrush" Color="#E3E2E6" />
    <SolidColorBrush x:Key="BodyTextBrush" Color="#999999" />
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="#2B2930" />
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="#E6E0E9" />
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="#CAC4D0" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#D0BCFF" />
    <SolidColorBrush x:Key="OutlineBrush" Color="#938F99" />
    <SolidColorBrush x:Key="SurfaceContainerLowBrush" Color="#1D1B20" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#381E72" />
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="#4F378B" />
    <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="#EADDFF" />
    <SolidColorBrush x:Key="SecondaryContainerBrush" Color="#4A4458" />
    <SolidColorBrush x:Key="OnSecondaryContainerBrush" Color="#E8DEF8" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="#EFB8C8" />
    <SolidColorBrush x:Key="OnTertiaryBrush" Color="#492532" />
    <SolidColorBrush x:Key="TertiaryContainerBrush" Color="#5A4300" />
    <SolidColorBrush x:Key="OnTertiaryContainerBrush" Color="#FFDF8E" />
    <SolidColorBrush x:Key="WidgetBackgroundBrush" Color="#404659" />
    <SolidColorBrush x:Key="ErrorContainerBrush" Color="#8C1D18" />
    <SolidColorBrush x:Key="OnErrorContainerBrush" Color="#F9DEDC" />
    <SolidColorBrush x:Key="InverseSurfaceBrush" Color="#E6E0E9" />
    <SolidColorBrush x:Key="InverseOnSurfaceBrush" Color="#322F35" />
    <SolidColorBrush x:Key="InversePrimaryBrush" Color="#6750A4" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#99000000" />
    <!-- Hover state layer: the content color at 8 % opacity. -->
    <SolidColorBrush x:Key="HoverLayerBrush" Color="#14E6E0E9" />
    <SolidColorBrush x:Key="AlertBackgroundBrush" Color="#410002" />
    <SolidColorBrush x:Key="AlertTextBrush" Color="#FF897D" />

    <Thickness x:Key="LargeMargin">20</Thickness>

    <Thickness x:Key="NormalMargin">16</Thickness>
    <Thickness x:Key="SmallMargin">8</Thickness>

    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    <CornerRadius x:Key="DialogCornerRadius">28</CornerRadius>

    <Style x:Key="DialogSurface" TargetType="Border">
        <Setter Property="MaxWidth" Value="560" />
        <Setter Property="MinWidth" Value="280" />
        <Setter Property="Margin" Value="48" />
        <Setter Property="Padding" Value="24,24,16,8" />
        <Setter Property="CornerRadius" Value="{DynamicResource DialogCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}" />
    </Style>

    <!-- Text that takes no space while it has nothing to show. -->
    <Style x:Key="OptionalText" TargetType="TextBlock">
        <Style.Triggers>
            <Trigger Property="Text" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BodyMediumText" TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BodySmallText" TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}" />
    </Style>

    <Style x:Key="TitleMediumText" TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}" />
    </Style>

    <Style x:Key="TitleLargeText" TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}" />
    </Style>

    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceContainerHighBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource SearchCornerRadius}" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NumberField" TargetType="TextBox">
        <Setter Property="Width" Value="80" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Outline" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource OnSurfaceBrush}" />
                        </Trigger>
                        <!-- A focused outlined field has a thicker primary outline; the padding shrinks to keep the text in place. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            <Setter TargetName="Outline" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Outline" Property="Padding" Value="11,7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Material 3 slider, extra-small size: a 16-pixel track with 8-pixel outer corners and 2-pixel inner corners. -->
    <Style x:Key="SliderActiveTrack" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="16" CornerRadius="8,2,2,8" Background="{StaticResource PrimaryBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderInactiveTrack" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="16" CornerRadius="2,8,8,2" Background="{StaticResource SecondaryContainerBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppSlider" TargetType="c:MaterialSlider">
        <Setter Property="Height" Value="44" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:MaterialSlider">
                    <Grid>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderActiveTrack}" Command="{x:Static Slider.DecreaseLarge}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderInactiveTrack}" Command="{x:Static Slider.IncreaseLarge}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <!-- A 4-pixel handle with a 6-pixel gap on each side, which SliderStops relies on. -->
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Width="16" Height="44" Background="Transparent">
                                                <Border x:Name="Handle" Width="4" CornerRadius="2" Background="{StaticResource PrimaryBrush}" />
                                                <!-- A canvas does not clip, so the value indicator can sit above the slider. -->
                                                <Canvas Width="16" Height="0" VerticalAlignment="Top">
                                                    <!-- 44 pixels high, 12 pixels above the handle. -->
                                                    <Border x:Name="Indicator" Canvas.Left="-16" Canvas.Top="-56" Width="48" Height="44"
                                                            CornerRadius="22" Background="{StaticResource InverseSurfaceBrush}" Visibility="Collapsed">
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Medium"
                                                                   Foreground="{StaticResource InverseOnSurfaceBrush}"
                                                                   Text="{Binding Value, RelativeSource={RelativeSource AncestorType=Slider}, StringFormat={}{0:0}}" />
                                                    </Border>
                                                </Canvas>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <!-- The handle narrows while pressed or focused. -->
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Handle" Property="Width" Value="2" />
                                                    <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <!-- The slider takes keyboard focus, not its handle, so the value shows from here. -->
                                                <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                                                    <Setter TargetName="Handle" Property="Width" Value="2" />
                                                    <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <c:SliderStops IsHitTestVisible="False" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value}" StopValue="{TemplateBinding StopValue}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HeadlineSmallText" TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TopAppBarTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- The hit target stays larger than the visible background. -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Layer" Width="40" Height="40" Background="Transparent"
                                CornerRadius="{DynamicResource IconCornerRadius}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Layer" Property="Background" Value="{StaticResource HoverLayerBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FilledButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="{DynamicResource FilledButtonPadding}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Container" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ButtonCornerRadius}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Container" Property="Opacity" Value="0.92" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Container" Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource FilledButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="{DynamicResource TextButtonPadding}" />
    </Style>

    <!-- A floating action button, in the tertiary color as on Breezy Weather's location list. -->
    <Style x:Key="FloatingActionButton" TargetType="Button">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Background" Value="{StaticResource TertiaryBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnTertiaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Container" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource FloatingActionCornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Container" Property="Opacity" Value="0.92" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A choice in a list dialog: a radio mark followed by its name. -->
    <Style x:Key="RadioOption" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Container" Background="Transparent" Padding="24,12">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="20" Height="20" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" Stroke="{StaticResource OnSurfaceVariantBrush}" StrokeThickness="2" />
                                <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{StaticResource PrimaryBrush}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource PrimaryBrush}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Container" Property="Background" Value="{StaticResource HoverLayerBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A Material 3 switch. -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="52" Height="32">
                        <Border x:Name="Track" CornerRadius="16" BorderThickness="2"
                                Background="{StaticResource SurfaceContainerHighBrush}" BorderBrush="{StaticResource OutlineBrush}" />
                        <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="8,0" HorizontalAlignment="Left"
                                 Fill="{StaticResource OutlineBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource PrimaryBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource OnPrimaryBrush}" />
                            <Setter TargetName="Thumb" Property="Width" Value="24" />
                            <Setter TargetName="Thumb" Property="Height" Value="24" />
                            <Setter TargetName="Thumb" Property="Margin" Value="4,0" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ResultList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Container" Background="Transparent" CornerRadius="{DynamicResource ResultCornerRadius}" Padding="16,10">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Container" Property="Background" Value="{StaticResource SurfaceContainerHighBrush}" />
                                    </Trigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DataContext.IsDesktopInterfaceEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Container" Property="Background" Value="{StaticResource SurfaceContainerHighBrush}" />
                                    </MultiDataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CompactIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
    </Style>

    <Style x:Key="AppContextMenu" TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource SurfaceContainerHighBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" Padding="4" CornerRadius="4"
                            BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <!-- Implicit styles here also reach the items of submenus, which follow the logical tree. -->
            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Grid>
                                <Border x:Name="Highlight" Padding="{TemplateBinding Padding}" CornerRadius="4" Background="Transparent">
                                    <DockPanel>
                                        <!-- The icons live in a sibling dictionary, so they are resolved at run time. -->
                                        <Path x:Name="Check" DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0"
                                              Stretch="Uniform" Fill="{TemplateBinding Foreground}"
                                              Data="{DynamicResource IconCheck}" Visibility="Collapsed" />
                                        <Path x:Name="Arrow" DockPanel.Dock="Right" Width="16" Height="16" Margin="16,0,0,0"
                                              Stretch="Uniform" Fill="{TemplateBinding Foreground}"
                                              Data="{DynamicResource IconChevronRight}" Visibility="Collapsed" />
                                        <!-- Location names are shown as written, so an underscore is not an access key. -->
                                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                                <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="4" AllowsTransparency="True"
                                       Focusable="False" PopupAnimation="None"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="{StaticResource SurfaceContainerHighBrush}" Padding="4" CornerRadius="4"
                                            BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Highlight" Property="Background" Value="{StaticResource HoverLayerBrush}" />
                                </Trigger>
                                <Trigger Property="Role" Value="SubmenuHeader">
                                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <!-- Checkable items keep the check column so their names stay aligned. -->
                                <Trigger Property="IsCheckable" Value="True">
                                    <Setter TargetName="Check" Property="Visibility" Value="Hidden" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.38" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Height="1" Background="{StaticResource OutlineBrush}" Opacity="0.5" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
    </Style>

    <!-- One scrollbar for the whole app: a thin rounded thumb with small arrows, and no track of its own. -->
    <Geometry x:Key="ScrollArrowUp">M0,5 L4,0 L8,5 Z</Geometry>
    <Geometry x:Key="ScrollArrowDown">M0,0 L8,0 L4,5 Z</Geometry>
    <Geometry x:Key="ScrollArrowLeft">M5,0 L0,4 L5,8 Z</Geometry>
    <Geometry x:Key="ScrollArrowRight">M0,0 L5,4 L0,8 Z</Geometry>

    <Style x:Key="ScrollBarArrow" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Path x:Name="Arrow" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{StaticResource OnSurfaceVariantBrush}" Opacity="0.5"
                              Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Arrow" Property="Opacity" Value="0.87" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" Margin="3" CornerRadius="3" Background="{StaticResource OnSurfaceVariantBrush}" Opacity="0.35" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="0.6" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                        </Grid.RowDefinitions>
                        <RepeatButton Style="{StaticResource ScrollBarArrow}" Command="ScrollBar.LineUpCommand"
                                      Tag="{StaticResource ScrollArrowUp}" />
                        <!-- Reversed so that the top of the track is the start of the content. -->
                        <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPage}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPage}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumb}" />
                            </Track.Thumb>
                        </Track>
                        <RepeatButton Grid.Row="2" Style="{StaticResource ScrollBarArrow}" Command="ScrollBar.LineDownCommand"
                                      Tag="{StaticResource ScrollArrowDown}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                </Grid.ColumnDefinitions>
                                <RepeatButton Style="{StaticResource ScrollBarArrow}" Command="ScrollBar.LineLeftCommand"
                                              Tag="{StaticResource ScrollArrowLeft}" />
                                <Track x:Name="PART_Track" Grid.Column="1">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarPage}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarPage}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumb}" />
                                    </Track.Thumb>
                                </Track>
                                <RepeatButton Grid.Column="2" Style="{StaticResource ScrollBarArrow}" Command="ScrollBar.LineRightCommand"
                                              Tag="{StaticResource ScrollArrowRight}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
