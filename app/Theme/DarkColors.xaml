<!-- The dark palette of the app's screens: Material 3's dark baseline scheme. ElevatedSurfaceBrush is the surface tinted
     with the primary color at 2 dp elevation, 6.94 %, as setting cards are drawn. The main card, body text, widget and
     alert brushes have no Material role and take the app's own colors. LightColors.xaml has the same keys. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">
    <SolidColorBrush x:Key="SurfaceBrush" po:Freeze="True" Color="#141218" />
    <SolidColorBrush x:Key="SurfaceContainerBrush" po:Freeze="True" Color="#211F26" />
    <SolidColorBrush x:Key="MainCardArcRootBrush" po:Freeze="True" Color="#1C1B1F" />
    <SolidColorBrush x:Key="MainCardTitleBrush" po:Freeze="True" Color="#E3E2E6" />
    <SolidColorBrush x:Key="MainCardTextBrush" po:Freeze="True" Color="#E3E2E6" />
    <SolidColorBrush x:Key="BodyTextBrush" po:Freeze="True" Color="#999999" />
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" po:Freeze="True" Color="#2B2930" />
    <SolidColorBrush x:Key="OnSurfaceBrush" po:Freeze="True" Color="#E6E0E9" />
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" po:Freeze="True" Color="#CAC4D0" />
    <SolidColorBrush x:Key="PrimaryBrush" po:Freeze="True" Color="#D0BCFF" />
    <SolidColorBrush x:Key="OutlineBrush" po:Freeze="True" Color="#938F99" />
    <SolidColorBrush x:Key="OutlineVariantBrush" po:Freeze="True" Color="#49454F" />
    <!-- Detail chart axes and guidelines are far fainter than OutlineBrush, so they stay behind the data. -->
    <SolidColorBrush x:Key="ChartLineBrush" po:Freeze="True" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="ChartLabelBrush" po:Freeze="True" Color="#B2B2B2" />
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" po:Freeze="True" Color="#211E28" />
    <SolidColorBrush x:Key="SurfaceContainerLowBrush" po:Freeze="True" Color="#1D1B20" />
    <SolidColorBrush x:Key="OnPrimaryBrush" po:Freeze="True" Color="#381E72" />
    <SolidColorBrush x:Key="PrimaryContainerBrush" po:Freeze="True" Color="#4F378B" />
    <SolidColorBrush x:Key="OnPrimaryContainerBrush" po:Freeze="True" Color="#EADDFF" />
    <SolidColorBrush x:Key="SecondaryContainerBrush" po:Freeze="True" Color="#4A4458" />
    <SolidColorBrush x:Key="OnSecondaryContainerBrush" po:Freeze="True" Color="#E8DEF8" />
    <SolidColorBrush x:Key="TertiaryBrush" po:Freeze="True" Color="#EFB8C8" />
    <SolidColorBrush x:Key="OnTertiaryBrush" po:Freeze="True" Color="#492532" />
    <SolidColorBrush x:Key="TertiaryContainerBrush" po:Freeze="True" Color="#5A4300" />
    <SolidColorBrush x:Key="OnTertiaryContainerBrush" po:Freeze="True" Color="#FFDF8E" />
    <SolidColorBrush x:Key="WidgetBackgroundBrush" po:Freeze="True" Color="#404659" />
    <SolidColorBrush x:Key="ErrorBrush" po:Freeze="True" Color="#F2B8B5" />
    <SolidColorBrush x:Key="ErrorContainerBrush" po:Freeze="True" Color="#8C1D18" />
    <SolidColorBrush x:Key="OnErrorContainerBrush" po:Freeze="True" Color="#F9DEDC" />
    <SolidColorBrush x:Key="InverseSurfaceBrush" po:Freeze="True" Color="#E6E0E9" />
    <SolidColorBrush x:Key="InverseOnSurfaceBrush" po:Freeze="True" Color="#322F35" />
    <SolidColorBrush x:Key="InversePrimaryBrush" po:Freeze="True" Color="#6750A4" />
    <SolidColorBrush x:Key="ScrimBrush" po:Freeze="True" Color="#99000000" />
    <SolidColorBrush x:Key="HoverLayerBrush" po:Freeze="True" Color="#14E6E0E9" />
    <SolidColorBrush x:Key="PressedLayerBrush" po:Freeze="True" Color="#1AE6E0E9" />
    <!-- The close button of the window takes Windows' own red when hovered or pressed, in both themes. -->
    <SolidColorBrush x:Key="CaptionCloseBrush" po:Freeze="True" Color="#C42B1C" />
    <SolidColorBrush x:Key="OnCaptionCloseBrush" po:Freeze="True" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AlertBackgroundBrush" po:Freeze="True" Color="#410002" />
    <!-- The main screen's title and caption text, also here so that its forecast columns, built before they join the
         screen, find a value; the main screen's own palette gives theirs once they are shown. -->
    <SolidColorBrush x:Key="TitleTextBrush" po:Freeze="True" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CaptionTextBrush" po:Freeze="True" Color="#999999" />
    <SolidColorBrush x:Key="AlertTextBrush" po:Freeze="True" Color="#FF897D" />
</ResourceDictionary>
