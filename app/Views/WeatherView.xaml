<UserControl x:Class="LibreccioWeather.Views.WeatherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="16,16,16,0" Style="{StaticResource TitleLargeText}" FontWeight="Normal"
                   Text="{Binding Place}" />

        <ProgressBar Grid.Row="1" Margin="0,8,0,0" Height="4" IsIndeterminate="True" BorderThickness="0"
                     Background="Transparent" Foreground="{StaticResource PrimaryBrush}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibility}}" />

        <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="8,0,8,16">
            <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource TitleLargeText}"
                       FontWeight="Bold" Text="{Binding WeatherText}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Margin="0,-10,0,0" FontSize="140" FontWeight="Bold"
                           Foreground="{StaticResource OnSurfaceBrush}" Text="{Binding TemperatureText}" />
                <TextBlock Grid.Column="2" Margin="0,5,0,0" FontSize="50" FontWeight="Bold"
                           Foreground="{StaticResource OnSurfaceBrush}" Text="{Binding TemperatureUnitText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TemperatureText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <TextBlock HorizontalAlignment="Center" Margin="0,-10,0,8" Style="{StaticResource TitleLargeText}"
                       FontWeight="Bold" Text="{Binding FeelsLikeText}" />

            <TextBlock HorizontalAlignment="Center" Style="{StaticResource TitleMediumText}"
                       FontWeight="Bold" Text="{Binding TemperatureRangeText}" />

            <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource BodyMediumText}"
                       Text="{Binding ErrorText}" />
        </StackPanel>
    </Grid>
</UserControl>
