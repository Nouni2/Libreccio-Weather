<UserControl x:Class="LibreccioWeather.Views.WeatherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:LibreccioWeather.Localization"
             xmlns:weather="clr-namespace:LibreccioWeather.Views.Weather">
    <Grid Background="{Binding BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Height="64" Margin="4,0,8,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsDesktopInterfaceEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button Style="{StaticResource CompactIconButton}" Command="{Binding DataContext.DesktopLocationsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="{l:Translate action_location_list}" AutomationProperties.Name="{l:Translate action_location_list}">
                    <ContentControl Style="{StaticResource Icon960}" Tag="{StaticResource IconList}" Width="20" Height="20" />
                </Button>
                <Button Style="{StaticResource CompactIconButton}" Command="{Binding RefreshCommand}"
                        ToolTip="{l:Translate action_refresh}" AutomationProperties.Name="{l:Translate action_refresh}">
                    <ContentControl Style="{StaticResource Icon960}" Tag="{StaticResource IconSync}" Width="20" Height="20" />
                </Button>
                <Button Style="{StaticResource CompactIconButton}" Command="{Binding DataContext.DesktopSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="{l:Translate action_settings}" AutomationProperties.Name="{l:Translate action_settings}">
                    <ContentControl Style="{StaticResource Icon24}" Tag="{StaticResource IconSettings}" Width="20" Height="20" />
                </Button>
            </StackPanel>
            <Button DockPanel.Dock="Left" Command="{Binding OpenLocationListCommand}"
                    ToolTip="{l:Translate action_location_list}" AutomationProperties.Name="{l:Translate action_location_list}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsDesktopInterfaceEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <ContentControl Style="{StaticResource Icon960}" Tag="{StaticResource IconList}" />
            </Button>
            <Grid>
                <TextBlock Margin="12,0,0,0" Style="{StaticResource TopAppBarTitle}" Text="{Binding Place}" />
            </Grid>
        </DockPanel>

        <ProgressBar Grid.Row="1" Height="4" IsIndeterminate="True" BorderThickness="0"
                     Background="Transparent" Foreground="{StaticResource PrimaryBrush}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibility}}" />

        <ScrollViewer x:Name="WeatherScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
            <StackPanel>
                <StackPanel Margin="8,0,8,16">
                    <!-- The time since the last refresh, with a clock icon, at the start of the header. -->
                    <StackPanel Margin="8,0,8,8" HorizontalAlignment="Left" Orientation="Horizontal"
                                AutomationProperties.Name="{Binding RefreshTimeDescription}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RefreshTimeText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ContentControl Style="{StaticResource Icon24}" Width="20" Height="20"
                                        Foreground="{StaticResource InverseSurfaceBrush}" Tag="{StaticResource IconTime}" />
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="14" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource InverseSurfaceBrush}" Text="{Binding RefreshTimeText}" />
                    </StackPanel>

                    <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource TitleLargeText}"
                               FontWeight="Bold" Text="{Binding WeatherText}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Margin="0,-10,0,0" FontSize="140" FontWeight="Bold"
                                   Foreground="{StaticResource OnSurfaceBrush}" Text="{Binding TemperatureText}" />
                        <TextBlock Grid.Column="2" Margin="0,5,0,0" FontSize="50" FontWeight="Bold"
                                   Foreground="{StaticResource OnSurfaceBrush}" Text="{Binding TemperatureUnitText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TemperatureText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <TextBlock HorizontalAlignment="Center" Margin="0,-10,0,8" Style="{StaticResource TitleLargeText}"
                               FontWeight="Bold" Text="{Binding FeelsLikeText}" />

                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource TitleMediumText}"
                               FontWeight="Bold" Text="{Binding TemperatureRangeText}" />

                    <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource BodyMediumText}"
                               Text="{Binding ErrorText}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding ForecastCards}" Margin="0,0,0,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <weather:ForecastCardView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
