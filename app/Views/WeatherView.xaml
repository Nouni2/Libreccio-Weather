<UserControl x:Class="LibreccioWeather.Views.WeatherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:LibreccioWeather.Localization"
             xmlns:weather="clr-namespace:LibreccioWeather.Views.Weather"
             xmlns:cards="clr-namespace:LibreccioWeather.Controls.WeatherCards"
             xmlns:forecast="clr-namespace:LibreccioWeather.ViewModels.Forecast"
             xmlns:conditions="clr-namespace:LibreccioWeather.ViewModels.WeatherCards"
             xmlns:animation="clr-namespace:LibreccioWeather.Controls.WeatherAnimation"
             xmlns:c="clr-namespace:LibreccioWeather.Controls"
             Background="{DynamicResource SurfaceBrush}">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type forecast:ForecastCardViewModel}">
            <weather:ForecastCardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type conditions:AstroCardViewModel}">
            <cards:AstroCardView Data="{Binding}" Margin="8" Cursor="Hand" MouseLeftButtonUp="OnAstroCardClick" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type conditions:ConditionsCardViewModel}">
            <cards:ConditionsCardView Data="{Binding}" Margin="8" Cursor="Hand" MouseLeftButtonUp="OnConditionsCardClick" />
        </DataTemplate>
        <!-- The precipitation of the next hour. The chart starts at the top of the subtitle, under it. -->
        <DataTemplate DataType="{x:Type conditions:NowcastCardViewModel}">
            <Border Margin="8" Background="{DynamicResource ElevatedSurfaceBrush}" CornerRadius="{DynamicResource ForecastCardCornerRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="20,20,20,0" Orientation="Horizontal">
                        <ContentControl Style="{StaticResource Icon960}" Tag="{StaticResource IconUmbrella}" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="Medium"
                                   Foreground="{DynamicResource InverseSurfaceBrush}" Text="{Binding Title}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Margin="20,2,20,0" VerticalAlignment="Top" FontSize="14" TextWrapping="Wrap"
                               Foreground="{DynamicResource BodyTextBrush}" Text="{Binding Subtitle}" />
                    <cards:NowcastChartView Grid.Row="1" Margin="4,2,4,0" VerticalAlignment="Top" Data="{Binding Chart}"
                                            AutomationProperties.Name="{Binding Description}" />
                </Grid>
            </Border>
        </DataTemplate>
        <!-- The alerts in force on the alert color, each a list item, or a line announcing alerts to come. -->
        <DataTemplate DataType="{x:Type conditions:AlertCardViewModel}">
            <Border Margin="8" Background="{DynamicResource AlertBackgroundBrush}" CornerRadius="{DynamicResource ForecastCardCornerRadius}"
                    Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding OpenCommand}" />
                </Border.InputBindings>
                <Grid>
                    <Border Padding="16,8" Background="Transparent"
                            Visibility="{Binding HasOnlyUpcomingAlerts, Converter={StaticResource BooleanToVisibility}}">
                        <DockPanel MinHeight="40">
                            <ContentControl DockPanel.Dock="Left" Margin="0,0,16,0" VerticalAlignment="Center" Style="{StaticResource Icon960}"
                                            Tag="{StaticResource IconWarning}" Foreground="{DynamicResource OnSurfaceBrush}"
                                            AutomationProperties.Name="{Binding UpcomingText}" />
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource TitleMediumText}" FontWeight="Normal" TextWrapping="Wrap"
                                       Foreground="{DynamicResource OnSurfaceBrush}" Text="{Binding UpcomingText}" />
                        </DockPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False"
                                  Visibility="{Binding HasCurrentAlerts, Converter={StaticResource BooleanToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,8" Background="Transparent">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding OpenCommand}" />
                                    </Border.InputBindings>
                                    <DockPanel MinHeight="56">
                                        <Path DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,16,0" VerticalAlignment="Center"
                                              Stretch="Uniform" Data="{StaticResource AlertTriangle}" Fill="{Binding ColorBrush}" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource TitleMediumText}" FontWeight="Normal" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource OnSurfaceBrush}" Text="{Binding Headline}" />
                                            <TextBlock Style="{StaticResource BodyMediumText}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource OnSurfaceVariantBrush}" Text="{Binding Dates}"
                                                       AutomationProperties.Name="{Binding DatesDescription}"
                                                       Visibility="{Binding HasDates, Converter={StaticResource BooleanToVisibility}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </DataTemplate>
        <!-- The credit of the forecast source in Material's body large type, bold, centered under the cards. -->
        <DataTemplate DataType="{x:Type conditions:FooterViewModel}">
            <c:SegmentedText Margin="8" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                             FontSize="16" LineHeight="24" FontWeight="Bold" Foreground="{Binding Foreground}"
                             Segments="{Binding Segments}" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid Background="{Binding BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The animated weather, behind the scrolling content. The top bar is in the window's title bar. -->
        <animation:WeatherAnimationView x:Name="WeatherAnimation" Grid.RowSpan="2"
                                        Condition="{Binding AnimationCondition}" Daylight="{Binding AnimationDaylight}"
                                        DarkMode="{Binding AnimationDarkMode}" Animate="{Binding AnimateBackground, Mode=OneTime}" />

        <!-- Follows a pull to refresh with the mouse wheel or a drag; it starts above the content and comes down with
             the pull. -->
        <c:PullRefreshIndicator x:Name="PullIndicator" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top"
                                Panel.ZIndex="1" Visibility="Collapsed"
                                DiscBrush="{DynamicResource SurfaceBrush}" ArcBrush="{Binding WeatherThemeBrush}" />

        <ProgressBar Grid.Row="0" Height="4" IsIndeterminate="True" BorderThickness="0"
                     Background="Transparent" Foreground="{DynamicResource PrimaryBrush}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibility}}" />

        <ScrollViewer x:Name="WeatherScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
            <StackPanel>
                <StackPanel x:Name="WeatherHeader" Margin="8,0,8,16">
                    <!-- 36 above the condition: its own 8, and the 28 of the refresh time's row that starts upstream's
                         header, which sits in the title bar here. -->
                    <TextBlock HorizontalAlignment="Center" Margin="0,36,0,0" Style="{StaticResource TitleLargeText}"
                               FontWeight="Light" Foreground="{DynamicResource InverseSurfaceBrush}" Text="{Binding WeatherText}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- The number and the unit are aligned by the top of their text boxes, laid out for a box of
                             1900 units above the baseline and 500 below per 2048 of the font size. The bundled Roboto's
                             box is 2146 and 555, so each margin also removes 246/2048 of the size at the top and 55/2048
                             at the bottom: -10 becomes -26.82 and 5 becomes -1.01. -->
                        <c:NumberAnimTextBlock x:Name="TemperatureNumber" Grid.Column="1" Margin="0,-26.82,0,-3.76" FontSize="140"
                                               FontFamily="pack://application:,,,/assets/fonts/#Roboto, Global User Interface" FontWeight="Bold"
                                               Foreground="{DynamicResource InverseSurfaceBrush}"
                                               IsAnimEnabled="{Binding IsTemperatureAnimated, Mode=OneTime}"
                                               NumberStart="{Binding TemperatureStartText}" NumberEnd="{Binding TemperatureText}"
                                               AutomationProperties.Name="{Binding TemperatureDescription}" />
                        <TextBlock Grid.Column="2" Margin="0,-1.01,0,-1.34" FontSize="50"
                                   FontFamily="pack://application:,,,/assets/fonts/#Roboto, Global User Interface" FontWeight="Bold"
                                   Foreground="{DynamicResource InverseSurfaceBrush}" Text="{Binding TemperatureUnitText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TemperatureText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <TextBlock HorizontalAlignment="Center" Margin="0,-10,0,8" Style="{StaticResource TitleLargeText}"
                               FontWeight="Light" Foreground="{DynamicResource InverseSurfaceBrush}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding FeelsLikeText}"
                               AutomationProperties.Name="{Binding FeelsLikeDescription}" />

                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource TitleMediumText}"
                               FontWeight="Light" Foreground="{DynamicResource InverseSurfaceBrush}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding TemperatureRangeText}"
                               AutomationProperties.Name="{Binding TemperatureRangeDescription}" />
                </StackPanel>
                <!-- The card positions are filled from the code-behind, which keeps each position's view when a new
                     card of the same kind replaces the one shown. -->
                <ItemsControl x:Name="CardsList" Margin="0,0,0,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><cards:WeatherCardsPanel AnimateCards="{Binding IsCardsFadeInEnabled}" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type conditions:WeatherCardHost}">
                            <ContentControl Content="{Binding Card}" Focusable="False" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
