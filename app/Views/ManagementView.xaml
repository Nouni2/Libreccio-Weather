<UserControl x:Class="LibreccioWeather.Views.ManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:LibreccioWeather.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Centered title, with back on the left and settings on the right. -->
        <Grid Grid.Row="0" Margin="4,0">
            <Button HorizontalAlignment="Left" Style="{StaticResource IconButton}" Command="{Binding BackCommand}"
                    ToolTip="{l:Translate action_back}" AutomationProperties.Name="{l:Translate action_back}"
                    Visibility="{Binding CanGoBack, Converter={StaticResource BooleanToVisibility}}">
                <ContentControl Style="{StaticResource Icon24}" Tag="{StaticResource IconArrowBack}" />
            </Button>
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource TopAppBarTitle}" Text="{l:Translate locations}" />
            <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Command="{Binding OpenSettingsCommand}"
                    ToolTip="{l:Translate action_settings}" AutomationProperties.Name="{l:Translate action_settings}">
                <ContentControl Style="{StaticResource Icon24}" Tag="{StaticResource IconSettings}" />
            </Button>
        </Grid>

        <!-- The saved locations. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasLocations, Converter={StaticResource BooleanToVisibility}}">
            <ItemsControl x:Name="LocationList" Margin="16,12,16,96" MaxWidth="720" ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Sliding the card reveals delete at the start and source settings at the end. -->
                        <Grid Margin="0,0,0,8" ClipToBounds="True">
                            <Border CornerRadius="28" Background="{StaticResource ErrorContainerBrush}" Visibility="Collapsed">
                                <ContentControl HorizontalAlignment="Left" Margin="24,0" Style="{StaticResource Icon24}"
                                                Foreground="{StaticResource OnErrorContainerBrush}" Tag="{StaticResource IconDelete}" />
                            </Border>
                            <Border CornerRadius="28" Background="{StaticResource SecondaryContainerBrush}" Visibility="Collapsed">
                                <ContentControl HorizontalAlignment="Right" Margin="24,0" Style="{StaticResource Icon24}"
                                                Foreground="{StaticResource OnSecondaryContainerBrush}" Tag="{StaticResource IconSettings}" />
                            </Border>

                            <Border x:Name="Card" CornerRadius="28" Cursor="Hand"
                                    AutomationProperties.HelpText="{l:Translate location_swipe_to_delete}"
                                    MouseLeftButtonDown="OnCardMouseDown" MouseMove="OnCardMouseMove"
                                    MouseLeftButtonUp="OnCardMouseUp" LostMouseCapture="OnCardLostCapture">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource SurfaceContainerLowBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAlerts}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AlertBackgroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryContainerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <!-- The handle that drags the card to another position. -->
                                    <Border DockPanel.Dock="Left" Width="48" Background="Transparent" Cursor="SizeNS"
                                            ToolTip="{l:Translate settings_items_drag_to_sort}"
                                            MouseLeftButtonDown="OnHandleMouseDown">
                                        <ContentControl Tag="{StaticResource IconDrag}">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl" BasedOn="{StaticResource Icon24}">
                                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasAlerts}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AlertTextBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource OnPrimaryContainerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </Border>
                                    <StackPanel Margin="0,16,16,16" VerticalAlignment="Center">
                                        <TextBlock FontSize="16" FontWeight="Medium" TextTrimming="CharacterEllipsis" Text="{Binding Title}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource OnPrimaryContainerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock FontSize="14" TextTrimming="CharacterEllipsis" Text="{Binding Body}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
                                                    <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasAlerts}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AlertTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="{StaticResource NormalMargin}"
                Style="{StaticResource FloatingActionButton}" Command="{Binding AddLocationCommand}"
                ToolTip="{l:Translate action_add_new_location}" AutomationProperties.Name="{l:Translate action_add_new_location}"
                Visibility="{Binding HasLocations, Converter={StaticResource BooleanToVisibility}}">
            <ContentControl Style="{StaticResource Icon24}" Foreground="{StaticResource OnTertiaryBrush}" Tag="{StaticResource IconAdd}" />
        </Button>

        <!-- Without locations, the screen only offers to add one. -->
        <Button Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                Command="{Binding AddLocationCommand}" Content="{l:Translate action_add_new_location}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource FilledButton}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasLocations}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</UserControl>
