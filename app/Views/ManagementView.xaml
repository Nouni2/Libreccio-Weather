<UserControl x:Class="LibreccioWeather.Views.ManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:LibreccioWeather.Localization">
    <UserControl.Resources>
        <ContextMenu x:Key="LocationActions" Style="{StaticResource AppContextMenu}"
                     DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{l:Translate desktop_open}" Command="{Binding OpenCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{l:Translate desktop_move_up}" Command="{Binding MoveUpCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{l:Translate desktop_move_down}" Command="{Binding MoveDownCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{l:Translate desktop_remove}" Command="{Binding RemoveCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Centered title, with back on the left and settings on the right. -->
        <Grid Grid.Row="0" Margin="4,0">
            <Button HorizontalAlignment="Left" Style="{StaticResource IconButton}" Command="{Binding BackCommand}"
                    ToolTip="{l:Translate action_back}" AutomationProperties.Name="{l:Translate action_back}"
                    Visibility="{Binding CanGoBack, Converter={StaticResource BooleanToVisibility}}">
                <ContentControl Style="{StaticResource Icon24}" Tag="{StaticResource IconArrowBack}" FlowDirection="{DynamicResource AppFlowDirection}" />
            </Button>
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource TopAppBarTitle}" Text="{l:Translate locations}" />
            <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Command="{Binding OpenSettingsCommand}"
                    ToolTip="{l:Translate action_settings}" AutomationProperties.Name="{l:Translate action_settings}">
                <ContentControl Style="{StaticResource Icon24}" Tag="{StaticResource IconSettings}" />
            </Button>
        </Grid>

        <!-- The saved locations. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasLocations, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel MaxWidth="720">
            <!-- The offer to check for app updates, which clicking accepts and the close button declines. -->
            <Border Margin="16,12,16,0" Padding="16" CornerRadius="28" Cursor="Hand" Background="{DynamicResource ElevatedSurfaceBrush}"
                    Visibility="{Binding ShowAppUpdatePrompt, Converter={StaticResource BooleanToVisibility}}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding EnableAppUpdateCheckCommand}" />
                </Border.InputBindings>
                <DockPanel>
                    <ContentControl DockPanel.Dock="Left" Margin="0,0,16,0" VerticalAlignment="Center" Style="{StaticResource Icon960}"
                                    Foreground="{DynamicResource OnSurfaceVariantBrush}" Tag="{StaticResource IconNotifications}" />
                    <Button DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource IconButton}"
                            Command="{Binding DismissAppUpdatePromptCommand}"
                            ToolTip="{l:Translate action_close}" AutomationProperties.Name="{l:Translate action_close}">
                        <ContentControl Style="{StaticResource Icon24}" Tag="{StaticResource IconClose}" />
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource TitleMediumText}" FontWeight="Normal" TextWrapping="Wrap"
                                   Text="{l:Translate dialog_app_update_check_title}" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyMediumText}" TextWrapping="Wrap"
                                   Text="{l:Translate dialog_app_update_check_content}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <ItemsControl x:Name="LocationList" Margin="16,12,16,96" ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Sliding the card reveals delete at the start and source settings at the end. -->
                        <Grid Margin="0,0,0,8" ClipToBounds="True">
                            <Border CornerRadius="{DynamicResource LocationCornerRadius}" Background="{DynamicResource ErrorContainerBrush}" Visibility="Collapsed">
                                <ContentControl HorizontalAlignment="Left" Margin="24,0" Style="{StaticResource Icon24}"
                                                Foreground="{DynamicResource OnErrorContainerBrush}" Tag="{StaticResource IconDelete}" />
                            </Border>
                            <Border CornerRadius="{DynamicResource LocationCornerRadius}" Background="{DynamicResource SecondaryContainerBrush}" Visibility="Collapsed">
                                <ContentControl HorizontalAlignment="Right" Margin="24,0" Style="{StaticResource Icon24}"
                                                Foreground="{DynamicResource OnSecondaryContainerBrush}" Tag="{StaticResource IconSettings}" />
                            </Border>

                            <Border x:Name="Card" CornerRadius="{DynamicResource LocationCornerRadius}" Cursor="Hand"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    AutomationProperties.Name="{Binding Title}"
                                    MouseLeftButtonDown="OnCardMouseDown" MouseMove="OnCardMouseMove"
                                    MouseLeftButtonUp="OnCardMouseUp" LostMouseCapture="OnCardLostCapture">
                                <Border.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding Tag.OpenCommand, ElementName=Card}" CommandParameter="{Binding}" />
                                    <KeyBinding Key="Delete" Command="{Binding Tag.RemoveCommand, ElementName=Card}" CommandParameter="{Binding}" />
                                    <KeyBinding Key="Up" Modifiers="Control" Command="{Binding Tag.MoveUpCommand, ElementName=Card}" CommandParameter="{Binding}" />
                                    <KeyBinding Key="Down" Modifiers="Control" Command="{Binding Tag.MoveDownCommand, ElementName=Card}" CommandParameter="{Binding}" />
                                </Border.InputBindings>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
                                        <Setter Property="Focusable" Value="{Binding DataContext.IsDesktopInterfaceEnabled, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Setter Property="AutomationProperties.HelpText" Value="{l:Translate location_swipe_to_delete}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsDesktopInterfaceEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="ContextMenu" Value="{StaticResource LocationActions}" />
                                                <Setter Property="AutomationProperties.HelpText" Value="{l:Translate desktop_location_actions}" />
                                            </DataTrigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding HasAlerts}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AlertBackgroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryContainerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <!-- The handle that drags the card to another position. -->
                                    <Border DockPanel.Dock="Left" Width="48" Background="Transparent" Cursor="SizeNS"
                                            ToolTip="{l:Translate settings_items_drag_to_sort}"
                                            MouseLeftButtonDown="OnHandleMouseDown">
                                        <ContentControl Tag="{StaticResource IconDrag}">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl" BasedOn="{StaticResource Icon24}">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasAlerts}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AlertTextBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </Border>
                                    <Image DockPanel.Dock="Left" Width="42" Height="42" Margin="0,0,8,0" VerticalAlignment="Center"
                                           Source="{Binding WeatherIconPath}"
                                           Visibility="{Binding HasWeatherIcon, Converter={StaticResource BooleanToVisibility}}" />
                                    <StackPanel Margin="0,16,16,16" VerticalAlignment="Center">
                                        <TextBlock FontSize="16" FontWeight="Medium" TextTrimming="CharacterEllipsis" Text="{Binding Title}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock FontSize="14" TextTrimming="CharacterEllipsis" Text="{Binding Body}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
                                                    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasAlerts}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AlertTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- The add button, with the debug location button above it in debug builds. -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="{StaticResource NormalMargin}"
                    Visibility="{Binding HasLocations, Converter={StaticResource BooleanToVisibility}}">
            <Button Margin="0,0,0,16" Style="{StaticResource FloatingActionButton}" Command="{Binding AddDebugLocationCommand}"
                    ToolTip="{l:Translate action_add_debug_location}" AutomationProperties.Name="{l:Translate action_add_debug_location}"
                    Visibility="{Binding CanAddDebugLocation, Converter={StaticResource BooleanToVisibility}}">
                <ContentControl Style="{StaticResource Icon960}" Foreground="{DynamicResource OnTertiaryBrush}" Tag="{StaticResource IconBugReport}" />
            </Button>
            <Button Style="{StaticResource FloatingActionButton}" Command="{Binding AddLocationCommand}"
                    ToolTip="{l:Translate action_add_new_location}" AutomationProperties.Name="{l:Translate action_add_new_location}">
                <ContentControl Style="{StaticResource Icon24}" Foreground="{DynamicResource OnTertiaryBrush}" Tag="{StaticResource IconAdd}" />
            </Button>
        </StackPanel>

        <!-- Without locations, the screen only offers to add one, or a debug location in debug builds. -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasLocations}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Button Style="{StaticResource FilledButton}" Command="{Binding AddLocationCommand}" Content="{l:Translate action_add_new_location}" />
            <Button Margin="0,8,0,0" Style="{StaticResource OutlinedButton}" Command="{Binding AddDebugLocationCommand}"
                    Visibility="{Binding CanAddDebugLocation, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource Icon960}" Width="18" Height="18" Foreground="{DynamicResource PrimaryBrush}"
                                    Tag="{StaticResource IconBugReport}" AutomationProperties.Name="{l:Translate settings_debug}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{l:Translate action_add_debug_location}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
