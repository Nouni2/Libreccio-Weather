<UserControl x:Class="LibreccioWeather.Views.AlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:LibreccioWeather.Localization"
             Background="{DynamicResource SurfaceBrush}">
    <UserControl.Resources>
        <!-- Text that can be selected and copied but not edited, drawn without a field's frame. -->
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="4,0,8,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Command="{Binding BackCommand}"
                    ToolTip="{l:Translate action_back}" AutomationProperties.Name="{l:Translate action_back}">
                <ContentControl Style="{StaticResource Icon24}" Tag="{StaticResource IconArrowBack}" FlowDirection="{DynamicResource AppFlowDirection}" />
            </Button>
            <TextBlock Margin="12,0,0,0" Style="{StaticResource TopAppBarTitle}" Text="{Binding Title}" />
        </DockPanel>

        <!-- Each alert is a card of its own, 16 apart; its texts can be selected, as upstream's selection container
             allows. -->
        <ScrollViewer x:Name="AlertsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Alerts" Margin="16,0,16,16" ItemsSource="{Binding Items}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource ElevatedSurfaceBrush}" CornerRadius="{DynamicResource ForecastCardCornerRadius}"
                                Padding="16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Margin" Value="0,0,0,16" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLast}" Value="True">
                                            <Setter Property="Margin" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel>
                                    <Path DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,16,0" VerticalAlignment="Center"
                                          Stretch="Uniform" Data="{StaticResource AlertTriangle}" Fill="{Binding ColorBrush}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBox Style="{StaticResource SelectableText}" FontSize="16" FontWeight="Bold"
                                                 Foreground="{DynamicResource OnSurfaceBrush}" Text="{Binding Headline, Mode=OneWay}" />
                                        <TextBlock FontSize="12" FontWeight="Medium" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource OnSurfaceVariantBrush}" Text="{Binding Dates}"
                                                   AutomationProperties.Name="{Binding DatesDescription}"
                                                   Visibility="{Binding HasDates, Converter={StaticResource BooleanToVisibility}}" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBox Margin="0,8,0,0" Style="{StaticResource SelectableText}" FontSize="14"
                                         Foreground="{DynamicResource OnSurfaceVariantBrush}" Text="{Binding Description, Mode=OneWay}"
                                         Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibility}}" />
                                <Border Margin="0,8,0,0" Height="1" Background="{DynamicResource OutlineVariantBrush}"
                                        Visibility="{Binding HasDividerBeforeInstruction, Converter={StaticResource BooleanToVisibility}}" />
                                <TextBox Margin="0,8,0,0" Style="{StaticResource SelectableText}" FontSize="14"
                                         Foreground="{DynamicResource OnSurfaceVariantBrush}" Text="{Binding Instruction, Mode=OneWay}"
                                         Visibility="{Binding HasInstruction, Converter={StaticResource BooleanToVisibility}}" />
                                <Border Margin="0,8,0,0" Height="1" Background="{DynamicResource OutlineVariantBrush}"
                                        Visibility="{Binding HasDividerBeforeSource, Converter={StaticResource BooleanToVisibility}}" />
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyMediumText}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource OnSurfaceVariantBrush}" Text="{Binding Source}"
                                           Visibility="{Binding HasSource, Converter={StaticResource BooleanToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
