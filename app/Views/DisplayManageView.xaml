<UserControl x:Class="LibreccioWeather.Views.DisplayManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:LibreccioWeather.Localization">
    <UserControl.Resources>
        <!-- The 40-pixel image buttons of the list rows, tinted with the primary color. -->
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <!-- A left-out entry, as an assist chip that adds it back when clicked. -->
        <Style x:Key="AssistChip" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="8" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" />
                            <Border x:Name="Layer" CornerRadius="8" Background="Transparent" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Layer" Property="Background" Value="{DynamicResource HoverLayerBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="4,0,4,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Command="{Binding BackCommand}"
                    ToolTip="{l:Translate action_back}" AutomationProperties.Name="{l:Translate action_back}">
                <ContentControl Style="{StaticResource Icon24}" Tag="{StaticResource IconArrowBack}" FlowDirection="{DynamicResource AppFlowDirection}" />
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding ResetToDefaultCommand}"
                    ToolTip="{l:Translate action_reset_to_default}" AutomationProperties.Name="{l:Translate action_reset_to_default}">
                <ContentControl Style="{StaticResource Icon960}" Tag="{StaticResource IconReplay}" FlowDirection="{DynamicResource AppFlowDirection}" />
            </Button>
            <TextBlock Margin="12,0,0,0" Style="{StaticResource TopAppBarTitle}" Text="{Binding Title}" />
        </DockPanel>

        <!-- The bottom padding lets the last rows scroll above the bar of chips. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="DisplayList" Margin="0,0,0,128" ItemsSource="{Binding DisplayedItems}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Each row is followed by a 1-pixel divider. Sliding a row either way uncovers delete. -->
                        <StackPanel>
                            <Grid Height="56" ClipToBounds="True">
                                <Border Background="{DynamicResource ErrorContainerBrush}" Visibility="Collapsed">
                                    <ContentControl HorizontalAlignment="Left" Margin="24,0" Style="{StaticResource Icon24}"
                                                    Foreground="{DynamicResource OnErrorContainerBrush}" Tag="{StaticResource IconDelete}" />
                                </Border>
                                <Border Background="{DynamicResource ErrorContainerBrush}" Visibility="Collapsed">
                                    <ContentControl HorizontalAlignment="Right" Margin="24,0" Style="{StaticResource Icon24}"
                                                    Foreground="{DynamicResource OnErrorContainerBrush}" Tag="{StaticResource IconDelete}" />
                                </Border>
                                <DockPanel Background="{DynamicResource SurfaceBrush}" AutomationProperties.Name="{Binding Name}"
                                           MouseLeftButtonDown="OnRowMouseDown" MouseMove="OnRowMouseMove"
                                           MouseLeftButtonUp="OnRowMouseUp" LostMouseCapture="OnRowLostCapture">
                                    <Button DockPanel.Dock="Left" Style="{StaticResource RowButton}" Cursor="SizeNS"
                                            ToolTip="{l:Translate settings_items_drag_to_sort}"
                                            AutomationProperties.Name="{l:Translate settings_items_drag_to_sort}"
                                            PreviewMouseLeftButtonDown="OnHandleMouseDown">
                                        <ContentControl Style="{StaticResource Icon24}" Tag="{StaticResource IconDrag}" />
                                    </Button>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource RowButton}"
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            ToolTip="{l:Translate settings_item_delete}" AutomationProperties.Name="{l:Translate settings_item_delete}">
                                        <ContentControl Style="{StaticResource Icon24}" Tag="{StaticResource IconClose}" />
                                    </Button>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource RowButton}" Command="{Binding ConfigureCommand}"
                                            Visibility="{Binding IsConfigurable, Converter={StaticResource BooleanToVisibility}}"
                                            ToolTip="{Binding ConfigureDescription}" AutomationProperties.Name="{Binding ConfigureDescription}">
                                        <ContentControl Style="{StaticResource Icon24}" Tag="{StaticResource IconSettings}" />
                                    </Button>
                                    <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="Medium"
                                               Foreground="{DynamicResource OnSurfaceBrush}" TextTrimming="CharacterEllipsis"
                                               Text="{Binding Name}" />
                                </DockPanel>
                            </Grid>
                            <Rectangle Height="1" Fill="{DynamicResource OutlineBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- The entries left out, which slide away once every entry is shown. -->
        <Border x:Name="BottomBar" Grid.Row="1" VerticalAlignment="Bottom" Background="{DynamicResource SurfaceBrush}">
            <Border.RenderTransform>
                <TranslateTransform />
            </Border.RenderTransform>
            <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                <ItemsControl Margin="8" ItemsSource="{Binding OtherItems}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource AssistChip}" Content="{Binding Name}"
                                    Command="{Binding DataContext.InsertItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
