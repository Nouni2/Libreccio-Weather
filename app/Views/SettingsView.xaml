<UserControl x:Class="LibreccioWeather.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:LibreccioWeather.Localization"
             xmlns:c="clr-namespace:LibreccioWeather.Controls"
             xmlns:s="clr-namespace:LibreccioWeather.ViewModels.Settings">
    <UserControl.Resources>
        <!-- The card behind every preference. It lights up under the pointer when it can be used. -->
        <Style x:Key="PreferenceCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceContainerLowBrush}" />
            <Setter Property="CornerRadius" Value="{Binding Corners}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="{Binding DataContext.IsDesktopInterfaceEnabled, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibility}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsDesktopInterfaceEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="Padding" Value="12" />
                </DataTrigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding IsEnabled}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource SurfaceContainerBrush}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.38" />
                    <Setter Property="Cursor" Value="Arrow" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Title, with the summary below it after a small gap. -->
        <DataTemplate x:Key="PreferenceText">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TitleMediumText}" FontWeight="Normal" TextWrapping="Wrap" Text="{Binding Title}" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyMediumText}" Text="{Binding Summary}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type s:SectionHeaderPreference}">
            <TextBlock Margin="{StaticResource NormalMargin}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryBrush}" Text="{Binding Title}"
                       Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibility}}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type s:SeparatorPreference}">
            <Border Height="{Binding Height}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type s:ClickablePreference}">
            <Border Style="{StaticResource PreferenceCard}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding ClickCommand}" />
                    <KeyBinding Key="Enter" Command="{Binding ClickCommand}" />
                    <KeyBinding Key="Space" Command="{Binding ClickCommand}" />
                </Border.InputBindings>
                <DockPanel>
                    <Viewbox DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,16,0">
                        <Viewbox.Style>
                            <Style TargetType="Viewbox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Viewbox.Style>
                        <Canvas Width="{Binding IconViewport}" Height="{Binding IconViewport}">
                            <Path Data="{Binding Icon}" Fill="{StaticResource OnSurfaceBrush}" />
                        </Canvas>
                    </Viewbox>
                    <ContentControl Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource PreferenceText}" />
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type s:ListPreference}">
            <Border Style="{StaticResource PreferenceCard}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding OpenCommand}" />
                    <KeyBinding Key="Enter" Command="{Binding OpenCommand}" />
                    <KeyBinding Key="Space" Command="{Binding OpenCommand}" />
                </Border.InputBindings>
                <ContentControl Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource PreferenceText}" />
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type s:SwitchPreference}">
            <Border Style="{StaticResource PreferenceCard}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding ToggleCommand}" />
                    <KeyBinding Key="Enter" Command="{Binding ToggleCommand}" />
                    <KeyBinding Key="Space" Command="{Binding ToggleCommand}" />
                </Border.InputBindings>
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource Switch}"
                              IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}" IsHitTestVisible="False" />
                    <ContentControl Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource PreferenceText}" />
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type s:SliderPreference}">
            <Border Style="{StaticResource PreferenceCard}" Cursor="Arrow">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="Field" Style="{StaticResource NumberField}" Text="{Binding ValueText}"
                                     IsEnabled="{Binding IsEnabled}" AutomationProperties.Name="{Binding Title}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding CommitTextCommand}"
                                                CommandParameter="{Binding Text, ElementName=Field}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource BodyMediumText}" Text="{Binding UnitText}" />
                            <Button Margin="8,0,0,0" Style="{StaticResource CompactIconButton}" Command="{Binding ResetCommand}"
                                    IsEnabled="{Binding IsEnabled}"
                                    ToolTip="{l:Translate action_reset_to_default}" AutomationProperties.Name="{l:Translate action_reset_to_default}">
                                <ContentControl Style="{StaticResource Icon24}" Tag="{StaticResource IconRestore}" />
                            </Button>
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource TitleMediumText}" FontWeight="Normal"
                                   TextWrapping="Wrap" Text="{Binding Title}" />
                    </DockPanel>
                    <!-- The delay keeps the settings file from being written at every step of a drag. -->
                    <c:MaterialSlider Margin="0,12,0,0" Style="{StaticResource AppSlider}"
                                      Minimum="{Binding SliderMinimum}" Maximum="{Binding SliderMaximum}" StopValue="{Binding Recommended}"
                                      SmallChange="10" LargeChange="100"
                                      Value="{Binding SliderValue, Delay=250}" IsEnabled="{Binding IsEnabled}"
                                      AutomationProperties.Name="{Binding Title}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="4,0,8,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Command="{Binding BackCommand}"
                    ToolTip="{l:Translate action_back}" AutomationProperties.Name="{l:Translate action_back}">
                <ContentControl Style="{StaticResource Icon24}" Tag="{StaticResource IconArrowBack}" />
            </Button>
            <TextBlock Margin="12,0,0,0" Style="{StaticResource TopAppBarTitle}" Text="{Binding Title}" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Margin="16,0,16,16" MaxWidth="720" ItemsSource="{Binding Items}" Focusable="False" />
        </ScrollViewer>
    </Grid>
</UserControl>
