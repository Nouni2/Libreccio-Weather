<UserControl x:Class="LibreccioWeather.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:LibreccioWeather.Localization">
    <Grid MaxWidth="720" Margin="{StaticResource NormalMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Left" Margin="0,0,8,0" Style="{StaticResource IconButton}" Command="{Binding BackCommand}"
                    ToolTip="{l:Translate action_back}" AutomationProperties.Name="{l:Translate action_back}">
                <ContentControl Style="{StaticResource Icon24}" Tag="{StaticResource IconArrowBack}" />
            </Button>
            <Grid>
                <TextBox x:Name="SearchInput"
                         Style="{StaticResource SearchBox}"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <!-- Placed by code where the box puts its first character, so the hint and the caret line up. -->
                <TextBlock x:Name="Placeholder" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="16"
                           Foreground="{StaticResource OnSurfaceVariantBrush}"
                           Text="{l:Translate location_search_placeholder}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text.Length, ElementName=SearchInput}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>

        <TextBlock Grid.Row="1" Margin="16,8,16,0" Style="{StaticResource BodySmallText}" Text="{Binding Attribution}" />

        <ProgressBar Grid.Row="2" Margin="0,8,0,0" Height="4" IsIndeterminate="True" BorderThickness="0"
                     Background="Transparent" Foreground="{StaticResource PrimaryBrush}"
                     Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibility}}" />

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <ListBox x:Name="ResultsList" Style="{StaticResource ResultList}" ItemsSource="{Binding Results}">
                <ListBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ChooseCommand}" CommandParameter="{Binding SelectedItem.Location, ElementName=ResultsList}" />
                </ListBox.InputBindings>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Background="Transparent">
                            <StackPanel.InputBindings>
                                <MouseBinding Gesture="LeftClick"
                                              Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                              CommandParameter="{Binding Location}" />
                            </StackPanel.InputBindings>
                            <TextBlock Style="{StaticResource TitleMediumText}" Text="{Binding Place}" />
                            <TextBlock Style="{StaticResource BodyMediumText}" Text="{Binding AdministrationLevels}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Margin="{StaticResource NormalMargin}">
                <TextBlock Style="{StaticResource TitleMediumText}" Text="{Binding NoResultsMessage}" TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyMediumText}" Text="{Binding NoResultsAdvice}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
