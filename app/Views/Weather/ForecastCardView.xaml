<UserControl x:Class="LibreccioWeather.Views.Weather.ForecastCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LibreccioWeather.Controls.Forecast"
             xmlns:icons="clr-namespace:LibreccioWeather.Icons"
             xmlns:controls="clr-namespace:LibreccioWeather.Controls"
             xmlns:l="clr-namespace:LibreccioWeather.Localization">
    <UserControl.Resources>
        <!-- A toggle of a connected button group: 40 high inside 4 of inset above and below, 16 at each side, in
             Material's label large type, on the surface container until chosen, then on the primary color. -->
        <Style x:Key="ConnectedGroupButton" TargetType="ToggleButton">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Margin="0,4" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <Border.CornerRadius>
                                <MultiBinding Converter="{x:Static controls:ConnectedCornersConverter.Instance}" ConverterParameter="Toggle">
                                    <Binding Path="(controls:ConnectedPosition.IsFirst)" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="(controls:ConnectedPosition.IsLast)" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="IsChecked" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="IsPressed" RelativeSource="{RelativeSource TemplatedParent}" />
                                </MultiBinding>
                            </Border.CornerRadius>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- The group's menu button: a filled tonal icon button, 40 square inside 4 of inset on every side. -->
        <Style x:Key="ConnectedGroupOverflowButton" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="{DynamicResource SecondaryContainerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainerBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Margin="4" Background="{TemplateBinding Background}">
                            <Border.CornerRadius>
                                <MultiBinding Converter="{x:Static controls:ConnectedCornersConverter.Instance}">
                                    <Binding Path="(controls:ConnectedPosition.IsFirst)" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="(controls:ConnectedPosition.IsLast)" RelativeSource="{RelativeSource TemplatedParent}" />
                                </MultiBinding>
                            </Border.CornerRadius>
                            <ContentControl Style="{StaticResource Icon960}" Tag="{StaticResource IconMoreVert}"
                                            Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <icons:WeatherIconImageConverter x:Key="WeatherIconImage" />
    </UserControl.Resources>
    <!-- A card on the surface raised by 2: Material tints the surface with the primary color at that elevation. -->
    <Border Margin="8" Background="{DynamicResource ElevatedSurfaceBrush}" CornerRadius="{DynamicResource ForecastCardCornerRadius}">
        <StackPanel>
            <StackPanel Margin="20,20,20,0">
                <StackPanel Orientation="Horizontal">
                    <!-- The icon takes the drawable's control tint, on-surface variant; the title the inverse surface. -->
                    <ContentControl Foreground="{DynamicResource OnSurfaceVariantBrush}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl" BasedOn="{StaticResource Icon960}">
                                <Setter Property="Tag" Value="{StaticResource IconCalendar}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDaily}" Value="False">
                                        <Setter Property="Tag" Value="{StaticResource IconSchedule}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TitleMediumText}"
                               Foreground="{DynamicResource InverseSurfaceBrush}" Text="{Binding Title}" />
                </StackPanel>
                <TextBlock Margin="0,2,0,0" Style="{StaticResource BodyMediumText}" Foreground="{DynamicResource BodyTextBrush}"
                           Text="{Binding Subtitle}" />
            </StackPanel>
            <!-- The chart choice as a connected button group; choices that do not fit go into the menu at its end. -->
            <controls:ConnectedButtonGroup Margin="20,4,0,0" HorizontalAlignment="Left" ItemsSource="{Binding Trends}"
                                           SelectedItem="{Binding SelectedTrend, Mode=TwoWay}" DisplayMemberPath="Name"
                                           OverflowLabel="{l:Translate action_more}"
                                           Visibility="{Binding HasMultipleTrends, Converter={StaticResource BooleanToVisibility}}"
                                           AutomationProperties.Name="{Binding Title}" />
            <Grid x:Name="ForecastViewport" Margin="0,8,0,0">
                <ScrollViewer x:Name="ForecastScroller" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto"
                              PanningMode="HorizontalOnly" PreviewMouseWheel="OnForecastMouseWheel">
                    <ItemsControl ItemsSource="{Binding Columns}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <c:ForecastColumnsPanel MinColumnWidth="{Binding MinColumnWidth}"
                                                        AvailableWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="{Binding DataContext.ColumnHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OnColumnClick"
                                      AutomationProperties.Name="{Binding Column.Description}" ToolTip="{Binding Column.Description}"
                                      ToolTipService.IsEnabled="{Binding DataContext.ShowsColumnTooltips, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="16" />
                                    </Grid.RowDefinitions>
                                    <!-- Today, later days, the first hour and midnights take the stronger colors. -->
                                    <TextBlock Margin="0,2" HorizontalAlignment="Center" Text="{Binding Column.Label}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TitleMediumText}">
                                                <Setter Property="Foreground" Value="{DynamicResource TitleTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Column.IsAccented}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Row="1" Margin="0,2" HorizontalAlignment="Center" Text="{Binding Column.Date}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyMediumText}">
                                                <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Column.IsAccented}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource CaptionTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border Grid.Row="2" Height="48" Visibility="{Binding Column.ShowDayIcon, Converter={StaticResource BooleanToVisibility}}">
                                        <Grid>
                                            <Image Width="32" Height="32" Source="{Binding Column.DayIcon, Converter={StaticResource WeatherIconImage}}"
                                                   AutomationProperties.Name="{Binding Column.Description}" />
                                            <Image Width="32" Height="32" Source="{Binding Column.DayWindIcon}" AutomationProperties.Name="{Binding Column.Description}" />
                                        </Grid>
                                    </Border>
                                    <c:PolylineAndHistogramView Grid.Row="3" Data="{Binding Column.Chart}" ClipToBounds="True"
                                                                Loaded="OnChartLoaded" SizeChanged="OnChartSizeChanged">
                                        <c:PolylineAndHistogramView.Style>
                                            <Style TargetType="c:PolylineAndHistogramView">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Column.Chart.IsDoubleHistogram}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </c:PolylineAndHistogramView.Style>
                                    </c:PolylineAndHistogramView>
                                    <c:DoubleHistogramView Grid.Row="3" Data="{Binding Column.Chart.DoubleHistogram}" ClipToBounds="True">
                                        <c:DoubleHistogramView.Style>
                                            <Style TargetType="c:DoubleHistogramView">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Column.Chart.IsDoubleHistogram}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </c:DoubleHistogramView.Style>
                                    </c:DoubleHistogramView>
                                    <Border Grid.Row="4" Height="48">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Column.Chart.HasTopPolylineLabel}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Image Width="32" Height="32" Source="{Binding Column.NightIcon, Converter={StaticResource WeatherIconImage}}"
                                                   AutomationProperties.Name="{Binding Column.Description}" />
                                            <Image Width="32" Height="32" Source="{Binding Column.NightWindIcon}" AutomationProperties.Name="{Binding Column.Description}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <c:TrendReferenceLinesView x:Name="ReferenceLines" Data="{Binding SelectedTrend.Trend}"
                                           IsHitTestVisible="False" Focusable="False" ClipToBounds="True" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
