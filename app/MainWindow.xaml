<Window x:Class="LibreccioWeather.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LibreccioWeather.ViewModels"
        xmlns:s="clr-namespace:LibreccioWeather.ViewModels.Settings"
        xmlns:details="clr-namespace:LibreccioWeather.ViewModels.Details"
        xmlns:about="clr-namespace:LibreccioWeather.ViewModels.About"
        xmlns:locations="clr-namespace:LibreccioWeather.ViewModels.Locations"
        xmlns:errors="clr-namespace:LibreccioWeather.ViewModels.RefreshErrors"
        xmlns:views="clr-namespace:LibreccioWeather.Views"
        xmlns:l="clr-namespace:LibreccioWeather.Localization"
        xmlns:c="clr-namespace:LibreccioWeather.Controls"
        xmlns:cards="clr-namespace:LibreccioWeather.ViewModels.WeatherCards"
        Title="{l:Translate desktop_app_name}"
        Width="960"
        Height="720"
        MinWidth="400"
        MinHeight="500"
        UseLayoutRounding="True"
        NumberSubstitution.CultureSource="{DynamicResource AppNumberCultureSource}"
        NumberSubstitution.CultureOverride="{DynamicResource AppNumberCulture}"
        NumberSubstitution.Substitution="{DynamicResource AppNumberSubstitution}"
        Background="{DynamicResource SurfaceBrush}">
    <!-- The app draws its own title bar. The caption height is zero because WindowCaption reports the bar's caption,
         icon and maximize button to Windows itself; one pixel of frame kept at the bottom keeps the window's shadow. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False"
                      ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- The main screen's top bar in the window's title bar: the location list button, the location's name and the
             time since the last refresh, then the actions. -->
        <DataTemplate x:Key="WeatherTitleBar">
            <DockPanel Margin="0,0,8,0">
                <Border DockPanel.Dock="Left" Width="1" Height="16" Margin="16,0" VerticalAlignment="Center"
                        Background="{DynamicResource OutlineVariantBrush}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsDesktopInterfaceEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Style="{StaticResource CompactIconButton}" Command="{Binding DataContext.DesktopLocationsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="{l:Translate action_location_list}" AutomationProperties.Name="{l:Translate action_location_list}">
                        <ContentControl Style="{StaticResource Icon960}" Tag="{StaticResource IconList}" Width="20" Height="20" />
                    </Button>
                    <Button Style="{StaticResource CompactIconButton}" Command="{Binding RefreshCommand}"
                            ToolTip="{l:Translate action_refresh}" AutomationProperties.Name="{l:Translate action_refresh}">
                        <ContentControl Style="{StaticResource Icon960}" Tag="{StaticResource IconSync}" Width="20" Height="20" />
                    </Button>
                    <Button Style="{StaticResource CompactIconButton}" Command="{Binding DataContext.DesktopSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="{l:Translate action_settings}" AutomationProperties.Name="{l:Translate action_settings}">
                        <ContentControl Style="{StaticResource Icon24}" Tag="{StaticResource IconSettings}" Width="20" Height="20" />
                    </Button>
                </StackPanel>
                <!-- The top bar's overflow menu, with the actions that have no room as icons. -->
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="OnMoreClick" ContextMenuService.IsEnabled="False"
                        ToolTip="{l:Translate action_more}" AutomationProperties.Name="{l:Translate action_more}">
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource AppContextMenu}" Placement="Bottom"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{l:Translate action_open_in_other_app}" Command="{Binding OpenInOtherAppCommand}"
                                      AutomationProperties.HelpText="{l:Translate action_open_in_other_app_description}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <ContentControl Style="{StaticResource Icon960}" Tag="{StaticResource IconMoreVert}" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding EditLocationCommand}"
                        ToolTip="{l:Translate action_edit_location}" AutomationProperties.Name="{l:Translate action_edit_location}">
                    <ContentControl Style="{StaticResource Icon960}" Tag="{StaticResource IconEdit}" />
                </Button>
                <!-- Refresh has no pull gesture with a mouse, so the standard interface shows it as a button; the desktop
                     interface has its own in the panel above. -->
                <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}"
                        ToolTip="{l:Translate action_refresh}" AutomationProperties.Name="{l:Translate action_refresh}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsDesktopInterfaceEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <ContentControl Style="{StaticResource Icon960}" Tag="{StaticResource IconSync}" />
                </Button>
                <Button DockPanel.Dock="Left" Command="{Binding OpenLocationListCommand}"
                        ToolTip="{l:Translate action_location_list}" AutomationProperties.Name="{l:Translate action_location_list}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsDesktopInterfaceEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <ContentControl Style="{StaticResource Icon960}" Tag="{StaticResource IconList}" Width="20" Height="20" />
                </Button>
                <!-- The name keeps its width before the refresh time, which is shortened first when space runs out. Both
                     are smaller than in a top bar, to sit with the window's title. -->
                <DockPanel Margin="12,0,0,0">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource TopAppBarTitle}" FontSize="16" Text="{Binding Place}" />
                    <DockPanel Margin="16,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding RefreshTimeDescription}">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RefreshTimeText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <ContentControl DockPanel.Dock="Left" Style="{StaticResource Icon24}" Width="16" Height="16"
                                        Foreground="{DynamicResource OnSurfaceVariantBrush}" Tag="{StaticResource IconTime}" />
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}" Text="{Binding RefreshTimeText}" />
                    </DockPanel>
                </DockPanel>
            </DockPanel>
        </DataTemplate>

        <!-- In wide windows, the location list sits in a pane beside the main screen, which the list button folds. -->
        <DataTemplate x:Key="InterfacePages">
            <c:DrawerPanel IsAvailable="{Binding IsLocationPaneAvailable}" IsUnfold="{Binding IsLocationPaneOpen}" ClipToBounds="True">
                <ContentControl Content="{Binding LocationPane}" Focusable="False" />
                <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
            </c:DrawerPanel>
        </DataTemplate>
        <!-- Each page view model is shown with its view. -->
        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <views:SearchView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WeatherViewModel}">
            <views:WeatherView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ManagementViewModel}">
            <views:ManagementView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type s:SettingsPageViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type s:DisplayManageViewModel}">
            <views:DisplayManageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type details:DetailsViewModel}">
            <views:DetailsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlertsViewModel}">
            <views:AlertsView />
        </DataTemplate>

        <!-- A list preference's choices. -->
        <DataTemplate DataType="{x:Type s:ListDialogViewModel}">
            <Border Style="{StaticResource DialogSurface}" Padding="0,24,0,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="24,0,24,16" Style="{StaticResource HeadlineSmallText}" Text="{Binding Title}" />
                    <Button DockPanel.Dock="Bottom" Margin="0,8,16,0" HorizontalAlignment="Right" Style="{StaticResource TextButton}"
                            Command="{Binding CancelCommand}" Content="{Binding CancelText}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Options}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource RadioOption}" Content="{Binding Name}"
                                                 IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding ChooseCommand}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- The warning before turning background updates off. -->
        <DataTemplate DataType="{x:Type s:NeverRefreshDialogViewModel}">
            <Border Style="{StaticResource DialogSurface}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource TextButton}" Command="{Binding CancelCommand}" Content="{Binding CancelText}" />
                        <Button Margin="8,0,0,0" Style="{StaticResource TextButton}" Command="{Binding ContinueCommand}"
                                Content="{Binding ContinueText}" />
                    </StackPanel>
                    <ScrollViewer Margin="0,0,8,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyMediumText}" Text="{Binding Warning1}" />
                            <TextBlock Margin="0,16,0,0" Style="{StaticResource BodyMediumText}" Text="{Binding Warning2}" />
                            <TextBlock Margin="0,16,0,0" Style="{StaticResource BodyMediumText}" Text="{Binding Warning3}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DataTemplate>
        <!-- Choices in titled groups; a choice can be shown without being available. -->
        <DataTemplate DataType="{x:Type s:GroupedListDialogViewModel}">
            <Border Style="{StaticResource DialogSurface}" Padding="0,24,0,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="24,0,24,16" Style="{StaticResource HeadlineSmallText}" Text="{Binding Title}" />
                    <Button DockPanel.Dock="Bottom" Margin="0,8,16,0" HorizontalAlignment="Right" Style="{StaticResource TextButton}"
                            Command="{Binding CancelCommand}" Content="{Binding CancelText}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                            <ItemsControl.Resources>
                                <DataTemplate DataType="{x:Type s:ListDialogGroupHeader}">
                                    <TextBlock Margin="24,12,24,4" FontSize="14" FontWeight="Medium"
                                               Foreground="{DynamicResource PrimaryBrush}" Text="{Binding Title}" />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type s:GroupedListDialogOption}">
                                    <RadioButton Style="{StaticResource RadioOption}" Content="{Binding Name}" IsEnabled="{Binding IsEnabled}"
                                                 IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding ChooseCommand}" />
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- The edit location dialog: entries with an icon, then Delete and Close. -->
        <DataTemplate DataType="{x:Type locations:EditLocationDialogViewModel}">
            <Border Style="{StaticResource DialogSurface}" Padding="0,24,0,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="24,0,24,16" Style="{StaticResource HeadlineSmallText}" Text="{Binding Title}" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,16,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource TextButton}" Foreground="{DynamicResource ErrorBrush}" Command="{Binding DeleteCommand}"
                                Content="{Binding DeleteText}" Visibility="{Binding CanDelete, Converter={StaticResource BooleanToVisibility}}" />
                        <Button Margin="8,0,0,0" Style="{StaticResource TextButton}" Command="{Binding CloseCommand}" Content="{Binding CloseText}" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Entries}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="24,12" Background="Transparent" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding ClickCommand}" />
                                        </Border.InputBindings>
                                        <DockPanel>
                                            <Viewbox DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <Canvas Width="{Binding IconViewport}" Height="{Binding IconViewport}" FlowDirection="LeftToRight">
                                                    <Path Data="{Binding Icon}" Fill="{DynamicResource OnSurfaceVariantBrush}" />
                                                </Canvas>
                                            </Viewbox>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource TitleMediumText}" FontWeight="Normal" Text="{Binding Title}" />
                                                <TextBlock Margin="0,4,0,0" Style="{StaticResource BodyMediumText}" TextWrapping="Wrap" Text="{Binding Summary}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- The testing locations of debug builds, under each source's name: the source in bold over the place, faded
             and unavailable once the place is saved. -->
        <DataTemplate DataType="{x:Type locations:DebugLocationDialogViewModel}">
            <Border Style="{StaticResource DialogSurface}" Padding="0,24,0,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="24,0,24,16" Style="{StaticResource HeadlineSmallText}" Text="{Binding Title}" />
                    <Button DockPanel.Dock="Bottom" Margin="0,8,16,0" HorizontalAlignment="Right" Style="{StaticResource TextButton}"
                            Command="{Binding CloseCommand}" Content="{Binding CloseText}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl Margin="8,0" ItemsSource="{Binding Groups}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Margin="16,0,16,8" FontSize="14" Foreground="{DynamicResource OnSurfaceBrush}" Text="{Binding Name}" />
                                        <ItemsControl ItemsSource="{Binding Entries}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,2" Padding="16,12" CornerRadius="4">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
                                                                <Setter Property="Cursor" Value="Hand" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                        <Setter Property="Background" Value="Transparent" />
                                                                        <Setter Property="Cursor" Value="Arrow" />
                                                                        <Setter Property="Opacity" Value="0.5" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Border.InputBindings>
                                                            <MouseBinding Gesture="LeftClick" Command="{Binding ChooseCommand}" />
                                                        </Border.InputBindings>
                                                        <StackPanel>
                                                            <TextBlock FontSize="16" FontWeight="Bold" Foreground="{DynamicResource OnSurfaceBrush}"
                                                                       Text="{Binding SourceName}" />
                                                            <TextBlock FontSize="14" Foreground="{DynamicResource OnSurfaceVariantBrush}" Text="{Binding Place}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- One location's own preferences, saved when closed. -->
        <DataTemplate DataType="{x:Type locations:PerLocationDialogViewModel}">
            <Border Style="{StaticResource DialogSurface}" Padding="0,24,0,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="24,0,24,16" Style="{StaticResource HeadlineSmallText}" Text="{Binding Title}" />
                    <Button DockPanel.Dock="Bottom" Margin="0,8,16,0" HorizontalAlignment="Right" Style="{StaticResource TextButton}"
                            Command="{Binding CloseCommand}" Content="{Binding CloseText}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Margin="24,0,24,8" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource PrimaryBrush}"
                                       Text="{Binding SectionTitle}" />
                            <Border Padding="24,12" Background="Transparent" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding EditCustomNameCommand}" />
                                </Border.InputBindings>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TitleMediumText}" FontWeight="Normal" Text="{Binding CustomNameTitle}" />
                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyMediumText}" Text="{Binding CustomNameSummary}" />
                                </StackPanel>
                            </Border>
                            <StackPanel Visibility="{Binding HasOpenMeteoSection, Converter={StaticResource BooleanToVisibility}}">
                                <TextBlock Margin="24,16,24,8" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource PrimaryBrush}"
                                           Text="{Binding OpenMeteoSectionTitle}" />
                                <Border Padding="24,12" Background="Transparent" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding OpenWeatherModelsCommand}" />
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource TitleMediumText}" FontWeight="Normal" Text="{Binding WeatherModelsTitle}" />
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyMediumText}" TextWrapping="Wrap"
                                                   Text="{Binding WeatherModelsSummary}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Open-Meteo's weather models for one location, each with a switch; a divider sets the best match apart and
             starts each provider's seamless group. -->
        <DataTemplate DataType="{x:Type locations:WeatherModelsDialogViewModel}">
            <Border Style="{StaticResource DialogSurface}" Padding="0,24,0,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="24,0,24,16" Style="{StaticResource HeadlineSmallText}" Text="{Binding Title}" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,16,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource TextButton}" Command="{Binding CancelCommand}" Content="{Binding CancelText}" />
                        <Button Margin="8,0,0,0" Style="{StaticResource TextButton}" Command="{Binding ConfirmCommand}" Content="{Binding ConfirmText}" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Models}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border Height="1" Background="{DynamicResource OutlineVariantBrush}"
                                                Visibility="{Binding HasDividerBefore, Converter={StaticResource BooleanToVisibility}}" />
                                        <Border Padding="24,12" Background="Transparent" Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick" Command="{Binding ToggleCommand}" />
                                            </Border.InputBindings>
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource Switch}"
                                                          IsChecked="{Binding IsEnabled}" IsHitTestVisible="False" AutomationProperties.Name="{Binding Name}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource TitleMediumText}" FontWeight="Normal" TextWrapping="Wrap" Text="{Binding Name}" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource BodyMediumText}" TextWrapping="Wrap"
                                                               Text="{Binding Description}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Border Height="1" Background="{DynamicResource OutlineVariantBrush}"
                                                Visibility="{Binding HasDividerAfter, Converter={StaticResource BooleanToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- The source of each feature the location uses: the feature, the source's credit with its links, and a button
             for the source's privacy policy. -->
        <DataTemplate DataType="{x:Type cards:DataSourcesDialogViewModel}">
            <Border Style="{StaticResource DialogSurface}" Padding="0,24,0,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="24,0,24,16" Style="{StaticResource HeadlineSmallText}" Text="{Binding Title}" />
                    <Button DockPanel.Dock="Bottom" Margin="0,8,16,0" HorizontalAlignment="Right" Style="{StaticResource TextButton}"
                            Command="{Binding CloseCommand}" Content="{Binding CloseText}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="16,8">
                                        <Button DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource IconButton}"
                                                Command="{Binding PrivacyPolicyCommand}"
                                                Visibility="{Binding HasPrivacyPolicy, Converter={StaticResource BooleanToVisibility}}"
                                                ToolTip="{Binding PrivacyPolicyText}" AutomationProperties.Name="{Binding PrivacyPolicyText}">
                                            <ContentControl Style="{StaticResource Icon960}" Tag="{StaticResource IconShieldLock}"
                                                            Foreground="{DynamicResource OnSurfaceBrush}" />
                                        </Button>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontSize="16" Foreground="{DynamicResource OnSurfaceBrush}" TextWrapping="Wrap" Text="{Binding Title}" />
                                            <c:SegmentedText FontSize="14" Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap"
                                                             Segments="{Binding Credit}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- A refresh error explained, with Close and, for some errors, the way to solve it. -->
        <DataTemplate DataType="{x:Type errors:ErrorHelpDialogViewModel}">
            <Border Style="{StaticResource DialogSurface}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,16" Style="{StaticResource HeadlineSmallText}" TextWrapping="Wrap"
                               Text="{Binding Title}" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Margin="0,0,8,0" Style="{StaticResource TextButton}" Command="{Binding ActionCommand}" Content="{Binding ActionText}"
                                Visibility="{Binding HasAction, Converter={StaticResource BooleanToVisibility}}" />
                        <Button Style="{StaticResource TextButton}" IsDefault="True" Command="{Binding CloseCommand}" Content="{Binding CloseText}" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Style="{StaticResource BodyMediumText}" TextWrapping="Wrap" Text="{Binding Content}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- The current position could not be found: two ways to go on, then Close. -->
        <DataTemplate DataType="{x:Type errors:LocationHelpDialogViewModel}">
            <Border Style="{StaticResource DialogSurface}" Padding="0,24,0,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="24,0,24,16" Style="{StaticResource HeadlineSmallText}" TextWrapping="Wrap"
                               Text="{Binding Title}" />
                    <Button DockPanel.Dock="Bottom" Margin="0,8,16,0" HorizontalAlignment="Right" Style="{StaticResource TextButton}"
                            IsDefault="True" Command="{Binding CloseCommand}" Content="{Binding CloseText}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Entries}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="24,12" Background="Transparent" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding ClickCommand}" />
                                        </Border.InputBindings>
                                        <DockPanel>
                                            <Viewbox DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <Canvas Width="{Binding IconViewport}" Height="{Binding IconViewport}" FlowDirection="LeftToRight">
                                                    <Path Data="{Binding Icon}" Fill="{DynamicResource OnSurfaceVariantBrush}" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyMediumText}" TextWrapping="Wrap"
                                                       Text="{Binding Title}" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Every error of a refresh, each with its source, and a help icon on those with help. -->
        <DataTemplate DataType="{x:Type errors:RefreshErrorDetailsDialogViewModel}">
            <Border Style="{StaticResource DialogSurface}" Padding="0,24,0,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="24,0,24,16">
                        <TextBlock Style="{StaticResource HeadlineSmallText}" TextWrapping="Wrap" Text="{Binding Title}" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyMediumText}" TextWrapping="Wrap" Text="{Binding Content}" />
                    </StackPanel>
                    <Button DockPanel.Dock="Bottom" Margin="0,8,16,0" HorizontalAlignment="Right" Style="{StaticResource TextButton}"
                            IsDefault="True" Command="{Binding CloseCommand}" Content="{Binding CloseText}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="24,16" Background="Transparent">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasHelp}" Value="True">
                                                        <Setter Property="Cursor" Value="Hand" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding ClickCommand}" />
                                        </Border.InputBindings>
                                        <DockPanel>
                                            <Viewbox DockPanel.Dock="Right" Width="24" Height="24" Margin="16,0,0,0" VerticalAlignment="Center"
                                                     AutomationProperties.Name="{Binding HelpText}"
                                                     Visibility="{Binding HasHelp, Converter={StaticResource BooleanToVisibility}}">
                                                <Canvas Width="960" Height="960">
                                                    <Path Data="{StaticResource IconHelp}" Fill="{DynamicResource OnSurfaceVariantBrush}" />
                                                </Canvas>
                                            </Viewbox>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource TitleMediumText}" FontWeight="Normal" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource OnSurfaceBrush}" Text="{Binding Headline}" />
                                                <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyMediumText}" TextWrapping="Wrap"
                                                           Text="{Binding Supporting}"
                                                           Visibility="{Binding HasSupporting, Converter={StaticResource BooleanToVisibility}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- A question to confirm or cancel. -->
        <DataTemplate DataType="{x:Type locations:ConfirmDialogViewModel}">
            <Border Style="{StaticResource DialogSurface}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,16" Style="{StaticResource HeadlineSmallText}" Text="{Binding Title}" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource TextButton}" Command="{Binding CancelCommand}" Content="{Binding CancelText}" />
                        <Button Margin="8,0,0,0" Style="{StaticResource TextButton}" Command="{Binding ConfirmCommand}" Content="{Binding ConfirmText}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodyMediumText}" TextWrapping="Wrap" Text="{Binding Message}" />
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- The source of each feature of a location, saved together. -->
        <DataTemplate DataType="{x:Type locations:SecondarySourcesDialogViewModel}">
            <Border Style="{StaticResource DialogSurface}" Padding="0,24,0,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="24,0,24,16" Style="{StaticResource HeadlineSmallText}" Text="{Binding Title}" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,16,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource TextButton}" Command="{Binding CancelCommand}" Content="{Binding CancelText}" />
                        <Button Margin="8,0,0,0" Style="{StaticResource TextButton}" Command="{Binding SaveCommand}" Content="{Binding SaveText}" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Margin="8,0,8,8" Padding="16" CornerRadius="28" Background="{DynamicResource SecondaryContainerBrush}"
                                    Visibility="{Binding ShowsCurrentPositionDisclaimer, Converter={StaticResource BooleanToVisibility}}">
                                <TextBlock Style="{StaticResource BodyMediumText}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource OnSecondaryContainerBrush}" Text="{Binding CurrentPositionDisclaimer}" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Border Padding="24,12" Background="Transparent" Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftClick" Command="{Binding OpenCommand}" />
                                                </Border.InputBindings>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource TitleMediumText}" FontWeight="Normal" Text="{Binding Title}" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource BodyMediumText}" Text="{Binding Summary}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Margin="16,0" FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                                       TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}"
                                                       Text="{Binding DataContext.DuplicateText, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsForecast}" Value="True" />
                                                                    <Condition Binding="{Binding DataContext.IsLocationDuplicate, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- A line of text, with the pattern's error below it while the text does not match. -->
        <DataTemplate DataType="{x:Type s:EditTextDialogViewModel}">
            <Border Style="{StaticResource DialogSurface}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,16" Style="{StaticResource HeadlineSmallText}" Text="{Binding Title}" />
                    <Grid>
                        <TextBox x:Name="EditTextInput" Style="{StaticResource OutlinedTextField}" Tag="{Binding IsError}"
                                 Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="16,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="16"
                                   c:PlaceholderAlignment.Field="{Binding ElementName=EditTextInput}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}" Text="{Binding Placeholder}"
                                   Visibility="{Binding HasPlaceholder, Converter={StaticResource BooleanToVisibility}}" />
                    </Grid>
                    <TextBlock Margin="16,4,16,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}"
                               Text="{Binding ErrorText}" Visibility="{Binding IsError, Converter={StaticResource BooleanToVisibility}}" />
                    <StackPanel Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource TextButton}" Command="{Binding CancelCommand}" Content="{Binding CancelText}" />
                        <Button Margin="8,0,0,0" Style="{StaticResource TextButton}" IsDefault="True"
                                Command="{Binding DoneCommand}" Content="{Binding DoneText}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- The confirmation before a link opens outside the app. -->
        <DataTemplate DataType="{x:Type about:LinkDialogViewModel}">
            <Border Style="{StaticResource DialogSurface}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource TextButton}" Command="{Binding CancelCommand}" Content="{Binding CancelText}" />
                        <Button Margin="8,0,0,0" Style="{StaticResource TextButton}" IsDefault="True"
                                Command="{Binding ConfirmCommand}" Content="{Binding ConfirmText}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodyMediumText}" TextWrapping="Wrap" Text="{Binding Message}" />
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- A time typed as its hour and minute, with AM and PM on a 12-hour clock. -->
        <DataTemplate DataType="{x:Type s:TimePickerDialogViewModel}">
            <Border Style="{StaticResource DialogSurface}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,20" Style="{StaticResource BodyMediumText}" Text="{Binding Title}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="96" Height="72" FontSize="45" TextAlignment="Center" VerticalContentAlignment="Center"
                                 MaxLength="2" Text="{Binding HourText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="4,0" VerticalAlignment="Center" FontSize="57" Text=":"
                                   Foreground="{DynamicResource OnSurfaceBrush}" />
                        <TextBox Width="96" Height="72" FontSize="45" TextAlignment="Center" VerticalContentAlignment="Center"
                                 MaxLength="2" Text="{Binding MinuteText, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Margin="12,0,0,0" Width="52" VerticalAlignment="Center"
                                    Visibility="{Binding Is12Hour, Converter={StaticResource BooleanToVisibility}}">
                            <RadioButton Style="{StaticResource RadioOption}" Content="{Binding AmText}"
                                         IsChecked="{Binding IsAm, Mode=OneWay}"
                                         Command="{Binding SelectAmCommand}" />
                            <RadioButton Style="{StaticResource RadioOption}" Content="{Binding PmText}"
                                         IsChecked="{Binding IsPm, Mode=OneWay}" Command="{Binding SelectPmCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource TextButton}" Command="{Binding CancelCommand}" Content="{Binding CancelText}" />
                        <Button Margin="8,0,0,0" Style="{StaticResource TextButton}" IsDefault="True"
                                Command="{Binding ConfirmCommand}" Content="{Binding ConfirmText}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding DesktopHomeCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding DesktopSearchCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding DesktopLocationsCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding DesktopAppearanceCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding DesktopBackCommand}" />
        <KeyBinding Key="F5" Command="{Binding DesktopRefreshCommand}" />
    </Window.InputBindings>

    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The title bar, 48 high as Windows' title bars that hold controls: the window's icon and title, the main
             screen's top bar while it is shown, and room for the window's buttons, laid over it further down. -->
        <Grid x:Name="TitleBar" Height="48" Background="{DynamicResource SurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- While the main screen is shown, the shown weather's theme color tints the bar faintly, fading in from the
                 start towards the window's buttons; while an alert is in force, the alert color of the location list
                 does instead. -->
            <Border Grid.ColumnSpan="3" Opacity="0.25">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{Binding ShownWeatherPage.WeatherThemeBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShownWeatherPage.HasCurrentAlerts}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AlertTextBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="Transparent" />
                        <GradientStop Offset="1" Color="Black" />
                    </LinearGradientBrush>
                </Border.OpacityMask>
            </Border>
            <!-- The icon sits 16 from the window's edge and the title 16 from the icon. In a narrow window the title
                 gives its room to the main screen's top bar. -->
            <StackPanel Margin="16,0,0,0" Orientation="Horizontal" Style="{StaticResource WindowTitleContent}">
                <Image x:Name="TitleBarIcon" Width="16" Height="16" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Margin="16,0,0,0" Style="{StaticResource WindowTitleText}"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Visibility="{Binding IsWideLayout, Converter={StaticResource BooleanToVisibility}}" />
            </StackPanel>
            <ContentControl x:Name="TitleBarPage" Grid.Column="1" Focusable="False" Style="{StaticResource WindowTitleContent}"
                            Content="{Binding ShownWeatherPage}" ContentTemplate="{StaticResource WeatherTitleBar}" />
            <Border Grid.Column="2" Width="{Binding ActualWidth, ElementName=CaptionButtons}" />
        </Grid>

        <ContentControl x:Name="InterfaceHost" Grid.Row="1" Content="{Binding}" Focusable="False" />

        <!-- A message at the bottom, with its optional action. -->
        <Border Grid.Row="1" MaxWidth="560" Margin="16" Padding="16,4,8,4" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                CornerRadius="4" Background="{DynamicResource InverseSurfaceBrush}"
                DataContext="{Binding Snackbar}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel MinHeight="40">
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Command="{Binding ActionCommand}" Content="{Binding ActionText}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TextButton}">
                            <Setter Property="Foreground" Value="{DynamicResource InversePrimaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActionText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock VerticalAlignment="Center" FontSize="14" TextWrapping="Wrap"
                           Foreground="{DynamicResource InverseOnSurfaceBrush}" Text="{Binding Text}" />
            </DockPanel>
        </Border>

        <!-- The open dialog. A click outside it cancels it. -->
        <Grid x:Name="DialogHost" Grid.RowSpan="2" DataContext="{Binding Dialog}" Focusable="True" KeyboardNavigation.TabNavigation="Cycle">
            <Grid.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
            </Grid.InputBindings>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="{DynamicResource ScrimBrush}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding CancelCommand}" />
                </Border.InputBindings>
            </Border>
            <ContentControl HorizontalAlignment="Center" VerticalAlignment="Center" Content="{Binding}" Focusable="False" />
        </Grid>

        <!-- The window's buttons stay above an open dialog's scrim, as the system's do. Their glyphs are Windows' own:
             ChromeMinimize, ChromeMaximize or ChromeRestore, and ChromeClose. -->
        <StackPanel x:Name="CaptionButtons" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimizeClick" />
            <Button x:Name="MaximizeButton" Click="OnMaximizeClick">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                        <Setter Property="Content" Value="&#xE922;" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                <Setter Property="Content" Value="&#xE923;" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
