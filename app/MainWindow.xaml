<Window x:Class="LibreccioWeather.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LibreccioWeather.ViewModels"
        xmlns:views="clr-namespace:LibreccioWeather.Views"
        Title="Libreccio Weather"
        Icon="/assets/icons/icon.ico"
        Width="960"
        Height="720"
        MinWidth="400"
        MinHeight="500"
        Background="{StaticResource SurfaceBrush}">
    <Window.Resources>
        <!-- Each page view model is shown with its view. -->
        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <views:SearchView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WeatherViewModel}">
            <views:WeatherView />
        </DataTemplate>
    </Window.Resources>

    <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
</Window>
