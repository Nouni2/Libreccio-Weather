<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>LibreccioWeather</RootNamespace>
    <UseWPF>true</UseWPF>
    <!-- The tray icon uses System.Windows.Forms.NotifyIcon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The project file sits at the root, so the default globs would pick up every folder. -->
    <EnableDefaultItems>false</EnableDefaultItems>
    <ApplicationIcon>assets\icons\icon.ico</ApplicationIcon>
    <ApplicationManifest>packaging\Libreccio-Weather.manifest</ApplicationManifest>
    <!-- WPF takes its per-monitor DPI awareness from the manifest. The Windows Forms analyzer asks for ApplicationHighDpiMode
         instead, which only Windows Forms' own startup applies, so it would leave the WPF process unaware. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="assets\icons\icon.ico" />
    <!-- The main window takes the icon of the current season. -->
    <Resource Include="assets\icons\winter.ico" />
    <Resource Include="assets\icons\spring.ico" />
    <Resource Include="assets\icons\summer.ico" />
    <Resource Include="assets\icons\autumn.ico" />
    <Resource Include="assets\weather\*.png" />
    <Resource Include="assets\fonts\*.ttf" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="app\**\*.cs" />
    <!-- Link drops the app\ prefix so XAML resource paths, such as StartupUri, stay relative to app\. -->
    <ApplicationDefinition Include="app\App.xaml" Link="App.xaml" />
    <Page Include="app\**\*.xaml" Exclude="app\App.xaml" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="LICENCE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="assets\weather\LICENCE.md" Link="assets\weather\LICENCE.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="assets\fonts\LICENCE.md" Link="assets\fonts\LICENCE.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="docs\third-party-notices.md" Link="docs\third-party-notices.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Windows Forms is only used for the tray icon. Importing it everywhere would clash with WPF names such as UserControl. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Libreccio-Weather.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
</Project>
