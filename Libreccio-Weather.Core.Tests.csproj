<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>LibreccioWeather.Core.Tests</RootNamespace>
    <!-- xUnit v3 test projects run as their own executable. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- The project file sits at the root, so the default globs would pick up every folder. -->
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="tests\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Libreccio-Weather.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
</Project>
