<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- The licence documents must travel inside the executable with its libraries. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDir>$(MSBuildProjectDirectory)\build\publish\v$(Version)\win-x64\</PublishDir>
    <ReleaseArtifactDirectory>$(MSBuildProjectDirectory)\build\release\v$(Version)\</ReleaseArtifactDirectory>
  </PropertyGroup>
  <Target Name="ExcludePortableDebugSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
  <Target Name="CollectPortableExecutable" AfterTargets="Publish" Condition="'$(MSBuildProjectName)' == 'Libreccio-Weather'">
    <ItemGroup>
      <_UnexpectedPortableFile Include="$(PublishDir)**\*" Exclude="$(PublishDir)$(AssemblyName).exe" />
    </ItemGroup>
    <Error Condition="!Exists('$(PublishDir)$(AssemblyName).exe')" Text="The single-file executable was not published." />
    <Error Condition="'@(_UnexpectedPortableFile)' != ''" Text="The portable publish contains files outside its executable: @(_UnexpectedPortableFile)" />
    <MakeDir Directories="$(ReleaseArtifactDirectory)" />
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe"
          DestinationFiles="$(ReleaseArtifactDirectory)Libreccio-Weather-v$(Version)-win-x64.exe" />
  </Target>
</Project>
