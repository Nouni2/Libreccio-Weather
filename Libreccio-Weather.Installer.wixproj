<Project Sdk="WixToolset.Sdk/7.0.1">
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputName>Libreccio-Weather-v$(Version)-win-x64</OutputName>
    <OutputPath>$(MSBuildThisFileDirectory)build\release\v$(Version)\</OutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)\</IntermediateOutputPath>
    <PublishedAppDirectory>$(MSBuildThisFileDirectory)build\publish\v$(Version)\win-x64\</PublishedAppDirectory>
    <InstallerProductVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(Version)', '[-+].*$', ''))</InstallerProductVersion>
    <DefineConstants>$(DefineConstants);ReleaseVersion=$(Version);InstallerProductVersion=$(InstallerProductVersion)</DefineConstants>
    <Cultures>en-US</Cultures>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="packaging\installer.wxs" />
    <EmbeddedResource Include="packaging\installer.en-US.wxl" />
    <BindPath Include="$(PublishedAppDirectory)" BindName="PublishedApp" />
    <BindPath Include="$(MSBuildThisFileDirectory)assets\icons\" BindName="AppIcons" />
  </ItemGroup>
  <Target Name="RequirePublishedApplication" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(PublishedAppDirectory)Libreccio-Weather.exe')"
           Text="Publish Libreccio-Weather.csproj with packaging/portable-win-x64.pubxml before building the installer." />
  </Target>
</Project>
